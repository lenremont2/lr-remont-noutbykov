---
import LandingLayout from "../layouts/LandingLayout.astro";
import Reviews from "../components/sections/Reviews.astro";
import QuickContacts from "../components/sections/QuickContacts.astro";
import LeadCapture from "../components/sections/LeadCapture.astro";
import LeadButton from "../components/ui/LeadButton.astro";
import HomeProtection from "../components/sections/HomeProtection.astro";
import RepairFormats from "../components/sections/RepairFormats.astro";
import RepairProcess from "../components/sections/RepairProcess.astro";
import Symptoms from "../components/sections/Symptoms.astro";
import ServicePriceTable from "../components/ui/ServicePriceTable.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import ServiceFaq from "../components/ui/ServiceFaq.astro";
import RelatedServices from "../components/ui/RelatedServices.astro";
import {
  macbook,
  macbookPrices,
  pagePath,
  getSeo,
} from "../data/service-pages";

const macSymptoms = [
  {
    title: "Не включается и не реагирует на кнопку",
    image: "/media/mac-symptom-no-power.webp",
    imageAlt: "MacBook с тёмным экраном на диагностике цепей питания",
    href: "/noutbuk-ne-vklyuchaetsya.htm",
  },
  {
    title: "Залит водой, кофе или вином",
    image: "/media/mac-symptom-liquid.webp",
    imageAlt: "Пролитый кофе на клавиатуре и трекпаде MacBook",
    href: "/remont-noutbuka-posle-zalitiya.htm",
  },
  {
    title: "Разбит экран Retina или погасла подсветка",
    image: "/media/mac-symptom-screen.webp",
    imageAlt: "Повреждённый экран Retina с полосами и неравномерной подсветкой",
    href: "/remont-ekrana-noutbuka.htm",
  },
  {
    title: "Вздулась батарея или быстро садится",
    image: "/media/mac-symptom-battery.webp",
    imageAlt: "Вздувшийся аккумулятор MacBook, приподнявший стеклянный трекпад",
    href: "/noutbuk-ne-zaryazhaetsya.htm",
  },
  {
    title: "Не заряжается по USB-C или MagSafe",
    image: "/media/mac-symptom-charging.webp",
    imageAlt: "Подгоревшие контакты разъёма USB-C и MagSafe на корпусе MacBook",
    href: "/remont-razemov-noutbuka.htm",
  },
  {
    title: "Сильно греется и шумит вентиляторами",
    image: "/media/mac-symptom-overheating.webp",
    imageAlt: "Забитые пылью вентиляторы охлаждения внутри открытого MacBook",
    href: "/noutbuk-peregrevaetsya.htm",
  },
  {
    title: "Залипают клавиши или не работает трекпад",
    image: "/media/mac-symptom-keyboard.webp",
    imageAlt: "Ремонт механизма клавиш на клавиатуре MacBook",
    href: "/remont-klaviatury-noutbuka.htm",
  },
  {
    title: "Зависает на яблоке или тормозит macOS",
    image: "/media/mac-symptom-macos.webp",
    imageAlt:
      "Зависшая полоса загрузки macOS на экране MacBook с внешним накопителем",
    href: "/noutbuk-tormozit-ne-zagruzhaetsya.htm",
  },
];

const macTimeline = [
  {
    time: "40–90 мин",
    title: "Диагностика, чистка охлаждения и настройка macOS",
    desc: "Начинаем с проверки жалобы: питание, перегрев или сбой загрузки требуют разных действий. Необходимость чистки и настройки обсудим после диагностики.",
    points: [
      "Проверка питания и обсуждение доступа к файлам",
      "Чистка кулеров с заменой термопасты",
      "Проверка сбоев macOS и зависаний при запуске",
    ],
    image: "/media/repair-modular.jpg",
    imageAlt: "Инженер выполняет обслуживание и диагностику ноутбука",
  },
  {
    time: "1–2 дня",
    title: "Замена аккумулятора, клавиатуры, трекпада и разъёмов",
    desc: "После проверки подберём совместимую деталь и согласуем вариант замены. Конструкция MacBook определяет, можно ли заменить отдельный элемент или потребуется узел в сборе.",
    points: [
      "Замена батареи с проверкой контроллера заряда",
      "Выбор варианта замены клавиатуры или топкейса",
      "Восстановление разъёмов USB-C и MagSafe",
    ],
    image: "/media/repair-power.jpg",
    imageAlt: "Проверка цепей питания и разъёмов на стенде",
  },
  {
    time: "2–4 дня",
    title: "Пайка материнской платы и восстановление шлейфов",
    desc: "Если неисправность затрагивает плату или соединения, определим повреждённый участок. Возможность компонентного ремонта, обработку после жидкости и замену узла обсудим по результатам осмотра.",
    points: [
      "Компонентная пайка цепей питания и контроллеров USB-C",
      "Проверка подсветки, шлейфов и совместимости дисплея",
      "Итоговая проверка стабильности под нагрузкой",
    ],
    image: "/media/repair-bga.jpg",
    imageAlt: "Компонентная пайка платы на паяльной станции",
  },
];

const macBenefits = [
  {
    title: "Обсудим ремонт платы и замену узла",
    text: "После диагностики объясним, можно ли восстановить неисправный участок платы или требуется замена узла. Стоимость работ и совместимых деталей согласуем до ремонта.",
  },
  {
    title: "Учтём функции конкретной модели",
    text: "Сообщите, какие функции работали до неисправности. Возможность сохранить Touch ID, True Tone и другие особенности вашей модели обсудим до замены деталей; результат проверим при получении.",
  },
  {
    title: "Проверка перед компонентным ремонтом",
    text: "Сначала выясним, какой участок платы повреждён. Объясним, возможен ли ремонт компонентов в вашем случае и какие ограничения нужно учесть перед согласованием работ.",
  },
  {
    title: "Состояние корпуса фиксируем при приёме",
    text: "Сообщите о повреждениях и предыдущих работах. При передаче зафиксируем состояние устройства и комплектность, а при получении сопоставим результат с согласованным заказом.",
  },
  {
    title: "Диагностика в мастерской — 0 ₽",
    text: "Обычная диагностика в мастерской бесплатна даже при отказе от ремонта. Срочная диагностика стоит 500 ₽ и согласуется отдельно. Предложение по ремонту и полную стоимость обсудим до начала работ.",
  },
  {
    title: "Документы на ремонт и гарантия",
    text: "Оформляем наряд-заказ с юридическим лицом, выдаём кассовый чек, возвращаем старые детали и даём 1 год прямой гарантии.",
  },
];

const macProcess = [
  {
    title: "Сверка модели и симптомов",
    text: "Назовите модель и год выпуска, если они известны, и опишите проблему. Подойдут сведения из раздела «Об этом Mac», с корпуса, упаковки или документов. Уточним задачу и подходящий способ передачи устройства.",
  },
  {
    title: "Бесплатная диагностика",
    text: "Обычная диагностика в мастерской — 0 ₽ даже при отказе от ремонта. Необходимые проверки определяются по жалобе. Срочную диагностику за 500 ₽ и условия выездного обслуживания согласуем отдельно.",
  },
  {
    title: "Согласование сметы до начала работ",
    text: "Согласуем состав работ и общую стоимость с учётом деталей. Если предложение не подходит, сообщите об отказе до начала ремонта. Условия доставки и выбранного выездного формата обсудим отдельно.",
  },
  {
    title: "Проверка при получении и гарантия 1 год",
    text: "Вместе проверяем зарядку, экран, звук, клавиатуру, Touch ID и работу под нагрузкой. Выдаём чек, гарантийный талон и старые детали.",
  },
];

const macModels = [
  {
    family: "MacBook Air (M1 / M2 / M3)",
    focus:
      "При обращении уточним поколение и комплектацию Air. Проверим жалобу на питание, зарядку, экран или последствия жидкости; доступ к файлам и возможность ремонта обсудим отдельно.",
  },
  {
    family: "MacBook Pro 14″ и 16″ (M1 / M2 / M3 Pro & Max)",
    focus:
      "Назовите точную модель Pro и необходимые для работы функции. После проверки обсудим ремонт платы, разъёмов, дисплея или аккумулятора и совместимость предлагаемых деталей.",
  },
  {
    family: "MacBook Pro 13″, 15″ и 16″ (Intel)",
    focus:
      "Проверим изменения изображения при движении крышки, питание, клавиатуру и зарядку. Необходимость ремонта отдельной детали или замены узла определим по состоянию устройства.",
  },
  {
    family: "MacBook Air 13″ (Intel Retina и Unibody)",
    focus:
      "Уточним проявления сбоя и предыдущие работы. При жалобах на зарядку, нагрев или нестабильную работу обсудим необходимые проверки, совместимые детали и стоимость ремонта.",
  },
];
---

<LandingLayout {...getSeo(macbook)}>
  <div class="lr-mac-page" data-lr-page-context data-device-category="premium">
    <div class="lr-mac-topbar">
      <Breadcrumbs current={macbook.label} />
      <details class="lr-container lr-mac-subnav" data-lr-nav open>
        <summary>Разделы страницы</summary>
        <nav
          class="lr-mac-subnav__links"
          aria-label="Навигация по странице ремонта MacBook"
        >
          <a href="#lr-symptoms">Неисправности</a>
          <a href="#lr-timeline">Сроки ремонта</a>
          <a href="#lr-benefits">Преимущества</a>
          <a href="#lr-formats">Как сдать в ремонт</a>
          <a href="#lr-prices">Цены</a>
          <a href="#lr-brand-guide">Частые поломки Mac</a>
          <a href="#lr-faq">Вопросы и ответы</a>
        </nav>
      </details>
    </div>

    <section
      id="lr-hero"
      class="lr-section lr-mac-hero"
      aria-labelledby="lr-hero-title"
    >
      <div class="lr-container">
        <div class="lr-mac-hero__grid">
          <div class="lr-mac-hero__main">
            <h1 id="lr-hero-title" class="lr-mac-hero__title">
              {macbook.h1}
            </h1>
            <p class="lr-mac-hero__lead">{macbook.lead}</p>

            <div class="lr-mac-hero__actions" data-lr-hero-cta>
              <LeadButton
                label="Рассчитать стоимость ремонта"
                source="brand:MacBook"
                deviceCategory="premium"
              />
              <a class="lr-mac-hero__secondary" href="#lr-prices">
                Посмотреть прайс-лист
              </a>
            </div>

            <dl
              class="lr-mac-hero__metrics"
              aria-label="Условия ремонта MacBook"
            >
              <div class="lr-mac-hero__metric">
                <dt>0 ₽</dt>
                <dd>
                  Обычная диагностика в мастерской даже при отказе от ремонта
                </dd>
              </div>
              <div class="lr-mac-hero__metric">
                <dt>По модели</dt>
                <dd>
                  Сравним варианты восстановления и замены неисправного узла
                </dd>
              </div>
              <div class="lr-mac-hero__metric">
                <dt>До работ</dt>
                <dd>
                  Фиксируем точную стоимость в договоре до начала любого ремонта
                </dd>
              </div>
              <div class="lr-mac-hero__metric">
                <dt>1 год</dt>
                <dd>
                  Официальная гарантия по наряд-заказу на работу и запчасти
                </dd>
              </div>
            </dl>
          </div>

          <figure class="lr-mac-hero__showcase">
            <video
              class="lr-hero__video lr-mac-hero__video"
              controls
              playsinline
              preload="none"
              width="480"
              height="640"
              poster="/media/mobile-lab-exterior.webp"
              aria-label="Мобильная мастерская Ленремонта — ремонт MacBook"
            >
              <source src="/media/notebook-auto.mp4" type="video/mp4" />
              Мобильная мастерская Ленремонта — ремонт MacBook.
            </video>

            <figcaption class="lr-mac-hero__telemetry">
              <div>
                <span>Срок работ</span>
                <strong>После диагностики</strong>
              </div>
              <div>
                <span>Стоимость</span>
                <strong>До ремонта</strong>
              </div>
              <div>
                <span>Touch ID и True Tone</span>
                <strong>Обсудим заранее</strong>
              </div>
            </figcaption>
          </figure>
        </div>

        <QuickContacts />
      </div>
    </section>

    <Reviews />

    <Symptoms
      compact
      title="Что случилось с вашим MacBook?"
      lead="Выберите похожую проблему. После диагностики обсудим необходимые работы и полную стоимость ремонта."
      items={macSymptoms}
    />

    <section
      id="lr-timeline"
      class="lr-section lr-mac-chrono"
      aria-labelledby="lr-timeline-title"
    >
      <div class="lr-container">
        <div class="lr-mac-header">
          <h2 id="lr-timeline-title">
            Сколько времени занимает ремонт MacBook
          </h2>
          <p class="lr-mac-header__lead">
            Ниже — ориентиры для планирования, а не срок любого заказа.
            Диагностику, наличие деталей, доставку и объём работ учитываем
            отдельно. Срок для вашего MacBook согласуем после проверки.
          </p>
        </div>

        <div class="lr-mac-chrono__grid">
          {
            macTimeline.map((item) => (
              <article class="lr-mac-chrono__card">
                <figure class="lr-mac-chrono__media">
                  <img
                    src={item.image}
                    alt={item.imageAlt}
                    width="580"
                    height="360"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
                <div class="lr-mac-chrono__body">
                  <strong class="lr-mac-chrono__time">{item.time}</strong>
                  <h3>{item.title}</h3>
                  <p>{item.desc}</p>
                  <ul class="lr-mac-chrono__points">
                    {item.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>

        <div class="lr-mac-chrono__bar">
          <div class="lr-mac-chrono__bar-copy">
            <strong>Нужно срочно к рабочему дедлайну?</strong>
            <p>
              Можно обсудить срочную диагностику за 500 ₽. Сообщите нужную дату
              заранее: возможность выполнить ремонт к этому сроку уточним по
              модели, неисправности и наличию деталей.
            </p>
          </div>
          <LeadButton
            label="Уточнить срок готовности"
            source="repair-timeline"
          />
        </div>
      </div>
    </section>

    <section
      id="lr-benefits"
      class="lr-section lr-mac-econ"
      aria-labelledby="lr-benefits-title"
    >
      <div class="lr-container lr-mac-econ__layout">
        <div class="lr-mac-econ__manifesto">
          <h2 id="lr-benefits-title">Как выбираем способ ремонта MacBook</h2>
          <p class="lr-mac-econ__lead">
            При похожих симптомах могут потребоваться разные работы: от замены
            отдельного компонента до замены узла в сборе. Диагностика помогает
            сравнить варианты с учётом состояния MacBook, совместимости деталей
            и полной стоимости. Решение согласуем с вами.
          </p>

          <div
            class="lr-mac-econ__compare"
            aria-label="Варианты ремонта после диагностики"
          >
            <div class="lr-mac-econ__compare-row lr-mac-econ__compare-row--bad">
              <span>Замена узла в сборе</span>
              <strong>По модели</strong>
              <small
                >Совместимость, стоимость детали и срок уточним отдельно</small
              >
            </div>
            <div
              class="lr-mac-econ__compare-row lr-mac-econ__compare-row--good"
            >
              <span>Компонентный ремонт в Ленремонте</span>
              <strong>от 4 990 ₽</strong>
              <small
                >Возможность восстановления и доступ к данным зависят от
                повреждения</small
              >
            </div>
          </div>

          <div class="lr-mac-econ__admission">
            <strong>Честное правило наших мастеров</strong>
            <p>
              Если стоимость восстановления не подходит под ваши задачи, можно
              отказаться от ремонта. Обычная диагностика в мастерской остаётся
              бесплатной. До начала работ обсудим состав ремонта, детали и
              ограничения возможного результата.
            </p>
          </div>
        </div>

        <div class="lr-mac-econ__grid">
          {
            macBenefits.map((item) => (
              <article class="lr-mac-econ__card">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <RepairFormats linkToLocations={false} />

    <RepairProcess
      title="Как пройдёт ремонт MacBook"
      lead="Уточним модель, проверим неисправность и согласуем работы до ремонта. При получении проверим результат вместе с вами."
      items={macProcess}
    />

    <section
      id="lr-security"
      class="lr-section lr-mac-security"
      aria-labelledby="lr-security-title"
    >
      <div class="lr-container">
        <div class="lr-mac-header">
          <h2 id="lr-security-title">
            Доступ к файлам и состояние MacBook при передаче
          </h2>
          <p class="lr-mac-header__lead">
            До работ сообщите, какие файлы важно сохранить и есть ли резервная
            копия. Состояние устройства и необходимые действия с системой
            обсудим отдельно: возможность доступа к данным зависит от
            неисправности и модели.
          </p>
        </div>

        <div class="lr-mac-security__grid">
          <article class="lr-mac-security__card">
            <h3>Серийные номера в акте приёма</h3>
            <p>
              При оформлении записываем серийный номер корпуса, A-модель и
              состояние ноутбука в наряд-заказе. Сообщите о повреждениях,
              комплектности и предыдущем ремонте; сохраните документы о передаче
              устройства.
            </p>
          </article>
          <article class="lr-mac-security__card">
            <h3>Действия с системой согласуем отдельно</h3>
            <p>
              Если проверка или ремонт требуют работы с системой либо
              накопителем, обсудим необходимые действия до их выполнения.
              Сообщите об отсутствии резервной копии. Восстановление
              работоспособности и сохранение файлов — разные задачи.
            </p>
          </article>
          <article class="lr-mac-security__card">
            <h3>Согласование до пайки и возврат старых деталей</h3>
            <p>
              При скрытых следах залития мастер покажет состояние платы под
              микроскопом и заранее согласует стоимость. После ремонта все
              заменённые детали возвращаются вам.
            </p>
          </article>
        </div>

        <div class="lr-mac-security__footer">
          <p>
            При передаче оформляем документы на устройство и согласуем заказ до
            начала ремонта.
          </p>
          <LeadButton
            label="Проконсультироваться с мастером по Mac"
            source="security-rules"
          />
        </div>
      </div>
    </section>

    <HomeProtection securityAnchor={false} />

    <ServicePriceTable
      title="Стоимость работ по ремонту MacBook"
      rows={macbookPrices}
    />

    <section
      id="lr-brand-guide"
      class="lr-section lr-mac-dossier"
      aria-labelledby="lr-brand-guide-title"
    >
      <div class="lr-container lr-mac-dossier__layout">
        <aside class="lr-mac-dossier__sidebar">
          <nav
            class="lr-mac-dossier__nav"
            aria-label="Разделы справочника по ремонту MacBook"
          >
            <p class="lr-mac-dossier__nav-title">О ремонте MacBook</p>
            <a href="#lr-mac-checks">Типовые поломки материнской платы</a>
            <a href="#lr-mac-data">Сохранение данных на T2 и M1/M2/M3</a>
            <a href="#lr-mac-model">Как узнать A-номер модели</a>
            <a href="#lr-prices">Прайс-лист на работы</a>
          </nav>

          <div class="lr-mac-dossier__aside-card">
            <strong>Сначала причина, затем способ ремонта</strong>
            <p>
              Назовите модель и симптомы, даже если устройство уже осматривали.
              После диагностики обсудим варианты восстановления, необходимые
              детали и стоимость для вашего MacBook.
            </p>
          </div>
        </aside>

        <article class="lr-mac-dossier__article">
          <header id="lr-mac-checks" class="lr-mac-dossier__chapter">
            <h2 id="lr-brand-guide-title">
              Что определяет способ ремонта платы MacBook
            </h2>
            <p class="lr-mac-dossier__intro">
              Важно установить, какой узел неисправен и какие функции устройства
              затронуты. По результатам проверки объясним, возможен ли ремонт
              отдельного участка или нужна замена узла. Сравним полную стоимость
              вариантов с вашими задачами и обсудим ограничения. Если решите
              отказаться от ремонта, обычная диагностика в мастерской остаётся
              бесплатной.
            </p>

            <div class="lr-mac-dossier__cards">
              <div class="lr-mac-dossier__card">
                <h3>Гаснет подсветка экрана при открытии крышки (Flexgate)</h3>
                <p>
                  Если изображение меняется при движении крышки, сообщите об
                  этом при обращении. Проверим экран, подсветку и соединения;
                  после диагностики обсудим восстановление или замену узла.
                  Совместимость дисплея и доступность функций вашей модели
                  уточним до согласования работ.
                </p>
              </div>

              <div class="lr-mac-dossier__card">
                <h3>Не заряжается и не включается через порты USB-C</h3>
                <p>
                  Отсутствие зарядки само по себе не указывает на неисправность
                  одного контроллера. Сообщите модель блока питания и поведение
                  разных разъёмов. После проверки объясним, связана ли проблема
                  с кабелем, портом, аккумулятором или платой, и согласуем
                  необходимые работы.
                </p>
              </div>

              <div class="lr-mac-dossier__card">
                <h3>Чистка и восстановление платы после пролитой жидкости</h3>
                <p>
                  Расскажите, какая жидкость попала на MacBook, когда это
                  произошло и включали ли устройство после происшествия. Эти
                  сведения помогут при осмотре. Объём восстановления и
                  возможность доступа к данным можно оценить после диагностики;
                  способ обработки платы и замену повреждённых деталей согласуем
                  до ремонта.
                </p>
              </div>
            </div>
          </header>

          <section
            id="lr-mac-data"
            class="lr-mac-dossier__chapter"
            aria-labelledby="lr-mac-data-title"
          >
            <h2 id="lr-mac-data-title">
              Сохранение файлов на MacBook с чипами T2 и Apple Silicon
            </h2>
            <p class="lr-mac-dossier__intro">
              Сообщите, какие файлы нужно сохранить и есть ли резервная копия.
              Если MacBook работает, подготовьте копию важных данных до передачи
              в сервис: во время обслуживания может потребоваться стирание или
              замена накопителя.
            </p>
            <p>
              Рекомендации по резервной копии и подготовке устройства приведены
              в <a
                href="https://support.apple.com/ru-ru/116942"
                target="_blank"
                rel="noopener noreferrer"
                >официальной инструкции Apple перед обслуживанием Mac</a
              >.
            </p>
            <ul class="lr-mac-dossier__list">
              <li>
                <strong>Доступ согласуем отдельно:</strong> обсудим, нужен ли доступ
                к системе для проверки неисправности и какие рабочие файлы следует
                учитывать.
              </li>
              <li>
                <strong>Копирование данных — отдельная задача:</strong> если нужна
                помощь с переносом файлов, согласуем объём и стоимость до выполнения
                работ.
              </li>
              <li>
                <strong>Результат зависит от повреждения:</strong> восстановление
                работоспособности и получение доступа к файлам — разные задачи. Возможность
                сохранения данных зависит от состояния устройства.
              </li>
            </ul>
          </section>

          <section
            id="lr-mac-model"
            class="lr-mac-dossier__chapter"
            aria-labelledby="lr-mac-model-title"
          >
            <h2 id="lr-mac-model-title">
              Как узнать модель MacBook для точного расчёта стоимости
            </h2>
            <p class="lr-mac-dossier__intro">
              Сообщите название модели, год выпуска и маркировку корпуса, если
              они известны. Эти сведения помогут начать подбор; точную
              совместимость детали проверим перед согласованием замены.
            </p>

            <div class="lr-mac-dossier__howto">
              <div class="lr-mac-dossier__howto-card">
                <h3>Если MacBook включается</h3>
                <p>
                  Нажмите на значок  в левом верхнем углу экрана и откройте
                  пункт «Об этом Mac». В окне указана диагональ экрана, год
                  выпуска и процессор (например: MacBook Pro 14″, M1 Pro, 2021).
                </p>
              </div>
              <div class="lr-mac-dossier__howto-card">
                <h3>Если MacBook не включается</h3>
                <p>
                  Подготовьте сведения с нижней панели, оригинальной упаковки
                  или документов. Они помогут начать определение модели. Если
                  маркировка не читается или корпус меняли при ремонте, сообщите
                  об этом при обращении.
                </p>
              </div>
            </div>

            <div
              class="lr-mac-models"
              aria-label="Справочник популярных моделей MacBook"
            >
              {
                macModels.map((group) => (
                  <div class="lr-mac-models__item">
                    <strong>{group.family}</strong>
                    <p>{group.focus}</p>
                  </div>
                ))
              }
            </div>
            <p class="lr-mac-dossier__apple-link">
              Способы определения модели и серийного номера описаны в{" "}
              <a
                href="https://support.apple.com/ru-ru/102767"
                target="_blank"
                rel="noopener noreferrer"
              >
                официальной справке Apple по определению модели MacBook
              </a>
              .
            </p>
          </section>

          <div class="lr-mac-dossier__cta">
            <div>
              <h3>Назовите модель и симптом — обсудим ремонт</h3>
              <p>
                Мастер сориентирует по цене ремонта и зафиксирует смету до
                начала работ. Обычная диагностика в мастерской бесплатна даже
                при отказе от ремонта.
              </p>
            </div>
            <LeadButton
              label="Обсудить ремонт MacBook"
              source="macbook-article"
            />
          </div>
        </article>
      </div>
    </section>

    <ServiceFaq items={macbook.faq} />
    <RelatedServices current={pagePath(macbook)} />
    <LeadCapture
      title="Обсудим неисправность и стоимость ремонта MacBook"
      lead="Оставьте номер телефона — уточним модель, симптомы и удобный формат обслуживания. После диагностики согласуем необходимые работы и полную стоимость."
      serviceName="Ремонт MacBook"
    />
  </div>
</LandingLayout>
