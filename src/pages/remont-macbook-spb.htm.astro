---
import LandingLayout from "../layouts/LandingLayout.astro";
import RepairFormats from "../components/sections/RepairFormats.astro";
import Guarantee from "../components/sections/Guarantee.astro";
import Reviews from "../components/sections/Reviews.astro";
import LeadCapture from "../components/sections/LeadCapture.astro";
import LeadButton from "../components/ui/LeadButton.astro";
import Hero from "../components/sections/Hero.astro";
import Symptoms from "../components/sections/Symptoms.astro";
import RepairTimeline from "../components/sections/RepairTimeline.astro";
import Benefits from "../components/sections/Benefits.astro";
import RepairProcess from "../components/sections/RepairProcess.astro";
import SecurityRules from "../components/sections/SecurityRules.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import ServicePriceTable from "../components/ui/ServicePriceTable.astro";
import ServiceFaq from "../components/ui/ServiceFaq.astro";
import RelatedServices from "../components/ui/RelatedServices.astro";
import {
  macbook,
  macbookPrices,
  pagePath,
  getSeo,
} from "../data/service-pages";
---

<LandingLayout {...getSeo(macbook)}>
  <div class="lr-mac-page lr-child-page lr-brand-page">
    <Breadcrumbs current={macbook.label} />
    <Hero
      brand={{ ...macbook, heroImage: "/media/mobile-lab-interior.webp" }}
      imageWidth={1080}
      imageHeight={1080}
    />
    <Symptoms />
    <RepairTimeline />
    <Benefits />
    <RepairFormats linkToLocations={false} />
    <RepairProcess />
    <SecurityRules />
    <Guarantee />
    <Reviews />
    <ServicePriceTable
      title="Стоимость работ для MacBook"
      rows={macbookPrices}
    />
    <section
      id="lr-brand-guide"
      class="lr-section lr-child-guide"
      aria-labelledby="lr-brand-guide-title"
    >
      <div class="lr-container lr-child-guide__layout">
        <nav class="lr-child-contents" aria-label="Содержание статьи">
          <p>В этой статье</p>
          <a href="#lr-mac-checks">Причины сбоя и диагностика</a>
          <a href="#lr-mac-data">Что важно для ваших файлов</a>
          <a href="#lr-mac-model">Как определить модель</a>
          <a href="#lr-prices">Стоимость работ</a>
        </nav>
        <article class="lr-child-article">
          <header id="lr-mac-checks">
            <p class="lr-eyebrow">Модель, macOS и ваши данные</p>
            <h2 id="lr-brand-guide-title">
              Один MacBook. Разные причины сбоя.
            </h2>
            <p class="lr-child-intro">
              Зарядка, батарея, клавиатура, плата и macOS требуют разных
              проверок. Название неисправности не заменяет диагностику, а
              название Air или Pro — точную модель.
            </p>
          </header>
          <div class="lr-child-topics">
            <div>
              <h3>Нет питания или зарядки</h3><p>
                Проверим используемый адаптер, разъём и цепи питания. Возьмите
                зарядное устройство: важно воспроизвести проблему именно с вашим
                комплектом. Если MacBook включается, но не загружает систему,
                проверка пойдёт по другому сценарию.
              </p>
            </div>
            <div>
              <h3>Батарея, клавиатура, корпус</h3><p>
                Оценим неисправный узел и совместимость нужных компонентов.
                Возможность замены, состав разборки и стоимость зависят от
                конкретного MacBook. Наличие детали и срок обсуждаем после
                подбора, до начала работ.
              </p>
            </div>
            <div>
              <h3>Ошибка запуска macOS</h3><p>
                Уточним, на каком этапе останавливается запуск, и проверим
                систему и накопитель. Восстановление macOS, перенос данных и
                аппаратный ремонт — отдельные задачи. Выберем необходимые
                действия после проверки устройства.
              </p>
            </div>
          </div>
          <section
            id="lr-mac-data"
            class="lr-child-chapter"
            aria-labelledby="lr-mac-data-title"
          >
            <h2 id="lr-mac-data-title">
              Важные файлы обсуждаем до действий с накопителем
            </h2>
            <p class="lr-child-intro">
              Рабочие проекты, документы и фотографии могут быть важнее скорости
              ремонта. Сообщите об этом при обращении — сначала разберёмся с
              данными и вашим приоритетом.
            </p>
            <ul class="lr-child-list">
              <li>
                Уточним, есть ли актуальная резервная копия и доступ к ней.
              </li>
              <li>
                Оценим состояние накопителя; до проверки не обещаем восстановить
                любой файл.
              </li>
              <li>
                Согласуем переустановку, перенос или восстановление отдельно.
                Возможность сохранения данных зависит от состояния устройства.
              </li>
            </ul>
          </section>
          <section
            id="lr-mac-model"
            class="lr-child-chapter"
            aria-labelledby="lr-mac-model-title"
          >
            <h2 id="lr-mac-model-title">
              Назовите модель — подготовим следующий шаг
            </h2>
            <p class="lr-child-intro">
              Air, Pro, год выпуска и точное обозначение помогут обсуждать
              конструкцию и необходимые компоненты. Если данных о модели нет,
              поможем уточнить её при диагностике.
            </p>
            <div class="lr-child-topics">
              <div>
                <h3>Если MacBook включается</h3><p>
                  Откройте меню Apple и пункт «Об этом Mac». Запишите название
                  модели и год. Не публикуйте личные сведения из окна системы;
                  для начала обращения достаточно обозначения устройства.
                </p>
              </div>
              <div>
                <h3>Если MacBook не включается</h3><p>
                  Посмотрите маркировку на корпусе или упаковке. Расскажите, как
                  реагируют экран и питание, и возьмите зарядку. Если была
                  жидкость, не включайте устройство для дополнительной проверки.
                </p>
              </div>
              <a
                class="lr-text-action"
                href="https://support.apple.com/ru-ru/102767"
                target="_blank"
                rel="noopener noreferrer"
                >Как определить модель — инструкция Apple</a
              >
            </div>
          </section>
          <div class="lr-child-recommendation">
            <h3>Обсудим ремонт и важные файлы</h3>
            <p>
              Назовите модель, опишите проблему и сообщите о важных файлах.
              Сориентируем по цене и подберём удобный способ передачи
              устройства.
            </p>
            <div class="lr-child-recommendation__actions">
              <LeadButton
                label="Обсудить ремонт MacBook"
                source="macbook-article"
              />
            </div>
          </div>
        </article>
      </div>
    </section>
    <ServiceFaq items={macbook.faq} />
    <RelatedServices current={pagePath(macbook)} />
    <LeadCapture
      title="Расскажите, что случилось с MacBook"
      lead="Назовите модель, опишите проблему и сообщите о важных файлах. Сориентируем по цене и подберём удобный способ передачи устройства."
      serviceName="Ремонт MacBook"
    />
  </div>
</LandingLayout>
