---
import LandingLayout from "../layouts/LandingLayout.astro";
import RepairFormats from "../components/sections/RepairFormats.astro";
import Guarantee from "../components/sections/Guarantee.astro";
import Reviews from "../components/sections/Reviews.astro";
import LeadCapture from "../components/sections/LeadCapture.astro";
import LeadButton from "../components/ui/LeadButton.astro";
import Hero from "../components/sections/Hero.astro";
import Symptoms from "../components/sections/Symptoms.astro";
import RepairTimeline from "../components/sections/RepairTimeline.astro";
import Benefits from "../components/sections/Benefits.astro";
import RepairProcess from "../components/sections/RepairProcess.astro";
import SecurityRules from "../components/sections/SecurityRules.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import ServicePriceTable from "../components/ui/ServicePriceTable.astro";
import ServiceFaq from "../components/ui/ServiceFaq.astro";
import RelatedServices from "../components/ui/RelatedServices.astro";
import {
  macbook,
  macbookPrices,
  pagePath,
  getSeo,
} from "../data/service-pages";
---

<LandingLayout {...getSeo(macbook)}>
  <div class="lr-mac-page lr-child-page lr-brand-page">
    <Breadcrumbs current={macbook.label} />
    <Hero
      brand={{ ...macbook, heroImage: "/media/mobile-lab-interior.webp" }}
      imageWidth={1080}
      imageHeight={1080}
    />
    <Symptoms />
    <RepairTimeline />
    <Benefits />
    <RepairFormats linkToLocations={false} />
    <RepairProcess />
    <SecurityRules />
    <Guarantee />
    <Reviews />
    <ServicePriceTable
      title="Стоимость работ для MacBook"
      rows={macbookPrices}
    />
    <section
      id="lr-brand-guide"
      class="lr-section lr-child-guide"
      aria-labelledby="lr-brand-guide-title"
    >
      <div class="lr-container lr-child-guide__layout">
        <nav class="lr-child-contents" aria-label="Содержание статьи">
          <p>В этой статье</p>
          <a href="#lr-mac-checks">Причины сбоя и диагностика</a>
          <a href="#lr-mac-data">Что важно для ваших файлов</a>
          <a href="#lr-mac-model">Как определить модель</a>
          <a href="#lr-prices">Стоимость работ</a>
        </nav>
        <article class="lr-child-article">
          <header id="lr-mac-checks">
            <p class="lr-eyebrow">Анатомия поломок Apple Logic Board</p>
            <h2 id="lr-brand-guide-title">
              Пайка Logic Board без переплат: почему не нужно менять всю плату
              целиком
            </h2>
            <p class="lr-child-intro">
              Политика официальных сервисов Apple проста: при сбое одного
              копеечного конденсатора они приговаривают к замене всю плату в
              сборе, выставляя счет до 80% стоимости нового MacBook. В
              Ленремонте иной подход: мы находим конкретную микросхему или
              сгоревший фильтр шины питания и меняем только его. Честное
              признание: если на MacBook M1/M2/M3 выгорел сам кристалл
              процессора или короткое замыкание уничтожило чипы памяти NAND с
              зашифрованными данными, мы прямо скажем: «Восстановление
              нерентабельно, не тратьте деньги». Но в 90% типовых поломок —
              залитие, КЗ по шине PPBUS_G3H, сбой контроллеров Type-C CD3215 или
              обрыв подсветки Flexgate — мы возвращаем Mac к жизни в 3–4 раза
              дешевле блочной замены за 1–2 дня.
            </p>
          </header>
          <div class="lr-child-topics">
            <div>
              <h3>Перетирание шлейфа подсветки (Flexgate)</h3><p>
                В MacBook Pro поколений A1706, A1708, A1989 шлейф подсветки
                натянут вокруг шарнира. При открытии крышки шире 45° экран
                тухнет («эффект сцены»). Официалы требуют менять всю крышку за
                35 000+ руб. Мы восстанавливаем заводской шлейф микропайкой под
                стереомикроскопом с сохранением оригинальной Retina-матрицы в
                разы дешевле.
              </p>
            </div>
            <div>
              <h3>Выгорание контроллеров Type-C (CD3215 / CD3217)</h3><p>
                Неоригинальные зарядки или дешевые USB-C концентраторы пробивают
                контроллеры питания: Mac циклично зависает на 5V и не переходит
                в режим 20V (нет заряда). Мы меняем сгоревший чип на
                оригинальный и восстанавливаем силовую шину PPBUS_G3H за пару
                часов.
              </p>
            </div>
            <div>
              <h3>Залитие и коррозия под чипами SMC / T2 / Apple Silicon</h3><p>
                Влага мгновенно затягивается под BGA-компоненты поверхностным
                натяжением. Мы не «сушим» плату феном: отмываем Logic Board в
                ультразвуковой ванне со специальным составом, перекатываем
                окислившиеся микросхемы на новые BGA-шары и восстанавливаем
                съеденные дорожки текстолита.
              </p>
            </div>
          </div>
          <section
            id="lr-mac-data"
            class="lr-child-chapter"
            aria-labelledby="lr-mac-data-title"
          >
            <h2 id="lr-mac-data-title">
              Данные на чипах T2 и Apple Silicon: спасаем файлы ДО любых
              манипуляций с платой
            </h2>
            <p class="lr-child-intro">
              На современных Mac накопитель распаян на плате и аппаратно
              привязан к процессору. Если прошить BIOS наугад или перегреть
              плату — данные будут потеряны навсегда. Мы работаем по строгому
              протоколу сохранения информации.
            </p>
            <ul class="lr-child-list">
              <li>
                Сначала проводим замеры сопротивлений и поднимаем дежурные линии
                питания без риска задеть контроллер NAND.
              </li>
              <li>
                Если накопитель физически цел, снимаем полный образ системы в
                режиме DFU / Apple Configurator до глубокой пайки.
              </li>
              <li>
                Честно предупреждаем: если пробит сам чип памяти NAND, никакие
                программы не вернут зашифрованные файлы — поэтому диагностика
                всегда бесплатна. Возможность сохранения данных зависит от
                состояния устройства.
              </li>
            </ul>
          </section>
          <section
            id="lr-mac-model"
            class="lr-child-chapter"
            aria-labelledby="lr-mac-model-title"
          >
            <h2 id="lr-mac-model-title">
              Определите модель — назовем точную стоимость за 2 минуты
            </h2>
            <p class="lr-child-intro">
              Для точного подбора запчастей нужен A-номер с нижней крышки
              MacBook. Это сразу исключит ошибки в ревизиях шлейфов и
              контроллеров.
            </p>
            <div class="lr-child-topics">
              <div>
                <h3>Если MacBook включается</h3><p>
                  Откройте меню  → «Об этом Mac». Запишите точную модель
                  (например: MacBook Pro 14" M1 Pro 2021) и версию macOS для
                  быстрой сверки.
                </p>
              </div>
              <div>
                <h3>Если MacBook не включается</h3><p>
                  Переверните ноутбук: на алюминиевом дне выгравирован номер
                  модели из 5 знаков (например: Model A2338 или A2141). Если
                  было залитие — ни в коем случае не подключайте зарядку!
                </p>
              </div>
              <a
                class="lr-text-action"
                href="https://support.apple.com/ru-ru/102767"
                target="_blank"
                rel="noopener noreferrer"
                >Как определить модель — инструкция Apple</a
              >
            </div>
          </section>
          <div class="lr-child-recommendation">
            <h3>Узнайте точную смету компонентного ремонта MacBook</h3>
            <p>
              Назовите модель и симптомы. Инженер согласует стоимость ДО
              вскрытия: если цена вас не устроит — забираете ноутбук без единой
              копейки оплаты.
            </p>
            <div class="lr-child-recommendation__actions">
              <LeadButton
                label="Обсудить ремонт MacBook"
                source="macbook-article"
              />
            </div>
          </div>
        </article>
      </div>
    </section>
    <ServiceFaq items={macbook.faq} />
    <RelatedServices current={pagePath(macbook)} />
    <LeadCapture
      title="Спасём ваш MacBook от дорогостоящей блочной замены"
      lead="Назовите модель и симптомы. Инженер сориентирует по стоимости компонентного ремонта и зафиксирует цену до начала работ."
      serviceName="Ремонт MacBook"
    />
  </div>
</LandingLayout>
