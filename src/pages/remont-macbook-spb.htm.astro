---
import LandingLayout from "../layouts/LandingLayout.astro";
import Reviews from "../components/sections/Reviews.astro";
import QuickContacts from "../components/sections/QuickContacts.astro";
import LeadCapture from "../components/sections/LeadCapture.astro";
import LeadButton from "../components/ui/LeadButton.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import ServiceFaq from "../components/ui/ServiceFaq.astro";
import RelatedServices from "../components/ui/RelatedServices.astro";
import {
  macbook,
  macbookPrices,
  standardPrices,
  pagePath,
  getSeo,
} from "../data/service-pages";

const allPrices = [...macbookPrices, ...standardPrices];
const priceOf = (work: string) =>
  allPrices.find(([name]) => name === work)?.[1] ?? "По диагностике";

const macSymptoms = [
  {
    title: "Не включается и не реагирует на кнопку",
    price: priceOf("Ремонт платы или цепей питания"),
    time: "1–3 дня",
    image: "/media/mac-symptom-no-power.webp",
    imageAlt: "MacBook с тёмным экраном на диагностике цепей питания",
    href: "/noutbuk-ne-vklyuchaetsya.htm",
  },
  {
    title: "Залит водой, кофе или вином",
    price: priceOf("Ремонт после попадания жидкости"),
    time: "1–2 дня",
    image: "/media/mac-symptom-liquid.webp",
    imageAlt: "Пролитый кофе на клавиатуре и трекпаде MacBook",
    href: "/remont-noutbuka-posle-zalitiya.htm",
  },
  {
    title: "Разбит экран Retina или погасла подсветка",
    price: priceOf("Установка новой матрицы экрана"),
    time: "от 1 часа",
    image: "/media/mac-symptom-screen.webp",
    imageAlt: "Повреждённый экран Retina с полосами и неравномерной подсветкой",
    href: "/remont-ekrana-noutbuka.htm",
  },
  {
    title: "Вздулась батарея или быстро садится",
    price: priceOf("Замена приклеенного аккумулятора"),
    time: "1–2 дня",
    image: "/media/mac-symptom-battery.webp",
    imageAlt: "Вздувшийся аккумулятор MacBook, приподнявший стеклянный трекпад",
    href: "/noutbuk-ne-zaryazhaetsya.htm",
  },
  {
    title: "Не заряжается по USB-C или MagSafe",
    price: priceOf("Восстановление разъёма USB-C или MagSafe"),
    time: "1–2 дня",
    image: "/media/mac-symptom-charging.webp",
    imageAlt: "Подгоревшие контакты разъёма USB-C и MagSafe на корпусе MacBook",
    href: "/remont-razemov-noutbuka.htm",
  },
  {
    title: "Сильно греется и шумит вентиляторами",
    price: priceOf("Обслуживание охлаждения с полной разборкой"),
    time: "2–4 часа",
    image: "/media/mac-symptom-overheating.webp",
    imageAlt: "Забитые пылью вентиляторы охлаждения внутри открытого MacBook",
    href: "/noutbuk-peregrevaetsya.htm",
  },
  {
    title: "Залипают клавиши или не работает трекпад",
    price: priceOf("Замена клавиатуры или верхней панели"),
    time: "от 3 часов",
    image: "/media/mac-symptom-keyboard.webp",
    imageAlt: "Ремонт механизма клавиш на клавиатуре MacBook",
    href: "/remont-klaviatury-noutbuka.htm",
  },
  {
    title: "Зависает на яблоке или тормозит macOS",
    price: priceOf("Восстановление macOS с переносом данных"),
    time: "1–3 часа",
    image: "/media/mac-symptom-macos.webp",
    imageAlt:
      "Зависшая полоса загрузки macOS на экране MacBook с внешним накопителем",
    href: "/noutbuk-tormozit-ne-zagruzhaetsya.htm",
  },
];

const macTimeline = [
  {
    time: "40–90 мин",
    title: "Диагностика, чистка охлаждения и настройка macOS",
    desc: "При вас проверяем питание, сразу отключаем аккумулятор при свежем залитии, полностью чистим систему охлаждения от пыли и восстанавливаем загрузку macOS.",
    points: [
      "Замер линий питания без риска для данных",
      "Чистка кулеров с заменой термопасты",
      "Устранение сбоев macOS и зависаний при запуске",
    ],
    image: "/media/repair-modular.jpg",
    imageAlt: "Инженер выполняет обслуживание и диагностику ноутбука",
  },
  {
    time: "1–2 дня",
    title: "Замена аккумулятора, клавиатуры, трекпада и разъёмов",
    desc: "Аккуратно снимаем старую приклеенную батарею специальным составом без риска для трекпада, меняем клавиатуру отдельно от корпуса и ставим новые порты зарядки.",
    points: [
      "Замена батареи с проверкой контроллера заряда",
      "Замена клавиатуры с сохранением родного топкейса",
      "Восстановление разъёмов USB-C и MagSafe",
    ],
    image: "/media/repair-power.jpg",
    imageAlt: "Проверка цепей питания и разъёмов на стенде",
  },
  {
    time: "2–4 дня",
    title: "Пайка материнской платы и восстановление шлейфов",
    desc: "Отмываем плату в ультразвуковой ванне после залития, перепаиваем сгоревшие микросхемы питания под микроскопом и восстанавливаем шлейф подсветки экрана.",
    points: [
      "Компонентная пайка цепей питания и контроллеров USB-C",
      "Восстановление шлейфа подсветки без замены крышки",
      "Итоговая проверка стабильности под нагрузкой",
    ],
    image: "/media/repair-bga.jpg",
    imageAlt: "Компонентная пайка платы на паяльной станции",
  },
];

const macBenefits = [
  {
    title: "Сохраняем родную плату и серийный номер",
    text: "Точечная перепайка микросхем питания CD3215/CD3217, чарджеров ISL9240 и обвязки SMC обходится в 3–4 раза дешевле замены материнской платы в сборе.",
  },
  {
    title: "Работают Touch ID, True Tone и датчик сна",
    text: "Датчики MacBook привязаны к материнской плате. Сохраняя вашу родную плату и перенося прошивку матриц, мы сберегаем все заводские функции.",
  },
  {
    title: "Бережная пайка под микроскопом",
    text: "Работаем на инфракрасных и термовоздушных станциях с контролем температуры — без вздутия текстолита и перегрева соседних микросхем.",
  },
  {
    title: "Аккуратная сборка алюминиевых корпусов",
    text: "Калиброванные отвёртки Pentalobe и Torx, антистатические коврики и раскладка винтов по магнитной схеме. Никаких перепутанных винтов и вмятин на корпусе.",
  },
  {
    title: "Диагностика 0 ₽ без обязательств",
    text: "Вы узнаёте точную причину поломки и полную стоимость до начала работ. Если решите отложить ремонт — забираете собранный MacBook бесплатно.",
  },
  {
    title: "Официальный договор Ленремонта с 1989 года",
    text: "Оформляем наряд-заказ с юридическим лицом, выдаём кассовый чек, возвращаем старые детали и даём 1 год прямой гарантии.",
  },
];

const macFormats = [
  {
    format: "mobile-lab",
    featured: true,
    title: "Мобильная мастерская у дома или офиса",
    text: "Приедем по СПб и ЛО. Чистка и модульный ремонт за 40–90 минут прямо при вас.",
    specs: [
      "Замена батареи, разъёмов и чистка на месте",
      "Срочное отключение питания после залития",
      "Цены как в стационарном сервисе",
    ],
    cta: "Вызвать мобильную мастерскую",
    image: "/media/mobile-lab-exterior.webp",
    imageAlt: "Мобильная лаборатория Ленремонта у дома клиента",
    width: 480,
    height: 640,
  },
  {
    format: "workshop",
    featured: false,
    title: "В стационарной мастерской",
    text: "Для пайки материнских плат, замены контроллеров и чистки после залития.",
    specs: [
      "Диагностика 0 ₽ даже при отказе от ремонта",
      "Пайка плат M1/M2/M3 и Intel под микроскопом",
      "Фиксация серийных номеров в договоре",
    ],
    cta: "Подобрать мастерскую",
    image: "/media/laptop-engineer-hero.webp",
    imageAlt: "Инженер Ленремонта в стационарной мастерской",
    width: 580,
    height: 384,
  },
  {
    format: "courier",
    featured: false,
    title: "Курьер туда и обратно",
    text: "Заберём MacBook в защитном кофре по акту и привезём готовым с гарантией.",
    specs: [
      "Акт приёма-передачи с описью устройства",
      "Согласование сметы по телефону до работ",
      "Оплата после проверки при получении",
    ],
    cta: "Вызвать курьера",
    image: "/media/laptop-courier.webp",
    imageAlt: "Бережная передача ноутбука курьеру по акту",
    width: 580,
    height: 384,
  },
];

const macProcess = [
  {
    step: "01",
    title: "Сверка модели и симптомов",
    text: "Назовите пятизначный A-номер с нижней крышки (например, A2338) и опишите проблему. За 2 минуты сориентируем по стоимости и вероятной причине поломки.",
  },
  {
    step: "02",
    title: "Бесплатная диагностика",
    text: "В мастерской или на выезде проверяем цепи питания, тестируем порты USB-C и осматриваем плату под микроскопом за 0 ₽.",
  },
  {
    step: "03",
    title: "Согласование сметы до начала работ",
    text: "До начала пайки фиксируем с вами точную сумму работы и запчастей. Если цена не устроит — вы вправе отказаться без каких-либо оплат.",
  },
  {
    step: "04",
    title: "Проверка при получении и гарантия 1 год",
    text: "Вместе проверяем зарядку, экран, звук, клавиатуру, Touch ID и работу под нагрузкой. Выдаём чек, гарантийный талон и старые детали.",
  },
];

const macModels = [
  {
    family: "MacBook Air (M1 / M2 / M3)",
    focus:
      "Ремонт цепей питания и портов USB-C, замена экранов Liquid Retina, чистка и восстановление платы после залития с сохранением данных.",
  },
  {
    family: "MacBook Pro 14″ и 16″ (M1 / M2 / M3 Pro & Max)",
    focus:
      "Восстановление многослойных материнских плат, ремонт разъёмов MagSafe 3 и Thunderbolt, замена дисплеев и аккумуляторов.",
  },
  {
    family: "MacBook Pro 13″, 15″ и 16″ (Intel)",
    focus:
      "Восстановление шлейфа подсветки экрана без замены всей крышки, ремонт питания USB-C CD3215, замена клавиатур и батарей.",
  },
  {
    family: "MacBook Air 13″ (Intel Retina и Unibody)",
    focus:
      "Ремонт цепей зарядки, чистка системы охлаждения от пыли с заменой термопасты, установка новых аккумуляторов.",
  },
];
---

<LandingLayout {...getSeo(macbook)}>
  <div class="lr-mac-page">
    <div class="lr-mac-topbar">
      <Breadcrumbs current={macbook.label} />
      <nav
        class="lr-container lr-mac-subnav"
        aria-label="Навигация по странице ремонта MacBook"
      >
        <a href="#lr-symptoms">Неисправности</a>
        <a href="#lr-timeline">Сроки ремонта</a>
        <a href="#lr-benefits">Преимущества</a>
        <a href="#lr-formats">Как сдать в ремонт</a>
        <a href="#lr-prices">Цены</a>
        <a href="#lr-brand-guide">Частые поломки Mac</a>
        <a href="#lr-faq">Вопросы и ответы</a>
      </nav>
    </div>

    <section
      id="lr-hero"
      class="lr-section lr-mac-hero"
      aria-labelledby="lr-hero-title"
    >
      <div class="lr-container">
        <div class="lr-mac-hero__grid">
          <div class="lr-mac-hero__main">
            <h1 id="lr-hero-title" class="lr-mac-hero__title">
              {macbook.h1}
            </h1>
            <p class="lr-mac-hero__lead">{macbook.lead}</p>

            <div class="lr-mac-hero__actions" data-lr-hero-cta>
              <LeadButton
                label="Рассчитать стоимость ремонта"
                source="brand:MacBook"
              />
              <a class="lr-mac-hero__secondary" href="#lr-prices">
                Посмотреть прайс-лист
              </a>
            </div>

            <dl
              class="lr-mac-hero__metrics"
              aria-label="Условия ремонта MacBook"
            >
              <div class="lr-mac-hero__metric">
                <dt>0 ₽</dt>
                <dd>
                  Бесплатная диагностика даже если вы решите отложить ремонт
                </dd>
              </div>
              <div class="lr-mac-hero__metric">
                <dt>До 70%</dt>
                <dd>
                  Экономия на компонентном ремонте родной платы вместо её полной
                  замены
                </dd>
              </div>
              <div class="lr-mac-hero__metric">
                <dt>До работ</dt>
                <dd>
                  Фиксируем точную стоимость в договоре до начала любого ремонта
                </dd>
              </div>
              <div class="lr-mac-hero__metric">
                <dt>1 год</dt>
                <dd>
                  Официальная гарантия по наряд-заказу на работу и запчасти
                </dd>
              </div>
            </dl>
          </div>

          <figure class="lr-mac-hero__showcase">
            <video
              class="lr-hero__video lr-mac-hero__video"
              loop
              muted
              data-lr-hero-video
              playsinline
              preload="none"
              width="480"
              height="640"
              poster="/media/mobile-lab-exterior.webp"
              aria-label="Мобильная мастерская Ленремонта — ремонт MacBook"
            >
              <source src="/media/notebook-auto.mp4" type="video/mp4" />
              Мобильная мастерская Ленремонта — ремонт MacBook.
            </video>

            <figcaption class="lr-mac-hero__telemetry">
              <div>
                <span>Чистка и модули</span>
                <strong>40–90 минут</strong>
              </div>
              <div>
                <span>Пайка платы</span>
                <strong>1–3 дня</strong>
              </div>
              <div>
                <span>Touch ID и True Tone</span>
                <strong>Сохраняются</strong>
              </div>
            </figcaption>
          </figure>
        </div>

        <QuickContacts />
      </div>
    </section>

    <section
      id="lr-symptoms"
      class="lr-section lr-mac-symptoms"
      aria-labelledby="lr-symptoms-title"
    >
      <div class="lr-container">
        <div class="lr-mac-header">
          <h2 id="lr-symptoms-title">
            Что случилось с вашим MacBook? Меняем только неисправную деталь, а
            не всю плату целиком
          </h2>
          <p class="lr-mac-header__lead">
            Выберите похожую проблему. На бесплатной диагностике мастер точно
            определит причину поломки и назовёт итоговую сумму до начала работ.
          </p>
        </div>

        <div class="lr-mac-matrix">
          {
            macSymptoms.map((item) => (
              <a class="lr-mac-matrix__cell" href={item.href}>
                <img
                  class="lr-mac-matrix__image"
                  src={item.image}
                  alt={item.imageAlt}
                  width="768"
                  height="512"
                  loading="lazy"
                  decoding="async"
                />
                <div class="lr-mac-matrix__body">
                  <h3 class="lr-mac-matrix__title">{item.title}</h3>
                  <div class="lr-mac-matrix__meta">
                    <span class="lr-mac-matrix__price">{item.price}</span>
                    <span class="lr-mac-matrix__time">{item.time}</span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>

        <div class="lr-mac-shield">
          <div class="lr-mac-shield__copy">
            <h3>
              Никаких уловок с «ремонтом MacBook за 300 ₽» и навязанных услуг
            </h3>
            <p>
              Частая схема обмана: в рекламе обещают ремонт за 350 ₽, забирают
              ноутбук, а после разборки требуют 25 000–40 000 ₽ за «сложную
              настройку» или платную сборку. В Ленремонте диагностика бесплатна,
              точная сумма фиксируется в договоре до начала работ, а оплата
              происходит только после вашей проверки MacBook.
            </p>
          </div>
          <div class="lr-mac-shield__action">
            <LeadButton
              label="Узнать честную смету по симптомам"
              source="symptoms-other"
            />
          </div>
        </div>
      </div>
    </section>

    <section
      id="lr-timeline"
      class="lr-section lr-mac-chrono"
      aria-labelledby="lr-timeline-title"
    >
      <div class="lr-container">
        <div class="lr-mac-header">
          <h2 id="lr-timeline-title">
            Сколько времени занимает ремонт MacBook
          </h2>
          <p class="lr-mac-header__lead">
            Мы не обещаем перепаять многослойную плату за 15 минут «на коленке»,
            но и не держим ноутбук неделями. Срок зависит от сложности работ.
          </p>
        </div>

        <div class="lr-mac-chrono__grid">
          {
            macTimeline.map((item) => (
              <article class="lr-mac-chrono__card">
                <figure class="lr-mac-chrono__media">
                  <img
                    src={item.image}
                    alt={item.imageAlt}
                    width="580"
                    height="360"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
                <div class="lr-mac-chrono__body">
                  <strong class="lr-mac-chrono__time">{item.time}</strong>
                  <h3>{item.title}</h3>
                  <p>{item.desc}</p>
                  <ul class="lr-mac-chrono__points">
                    {item.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>

        <div class="lr-mac-chrono__bar">
          <div class="lr-mac-chrono__bar-copy">
            <strong>Нужно срочно к рабочему дедлайну?</strong>
            <p>
              Проведём приоритетную экспресс-диагностику на стенде (500 ₽) и
              примем ваш MacBook в работу вне очереди.
            </p>
          </div>
          <LeadButton
            label="Уточнить срок готовности"
            source="repair-timeline"
          />
        </div>
      </div>
    </section>

    <section
      id="lr-benefits"
      class="lr-section lr-mac-econ"
      aria-labelledby="lr-benefits-title"
    >
      <div class="lr-container lr-mac-econ__layout">
        <div class="lr-mac-econ__manifesto">
          <h2 id="lr-benefits-title">
            Почему к нам привозят MacBook после приговора официалов
          </h2>
          <p class="lr-mac-econ__lead">
            Авторизованные сервисы не паяют платы по правилам Apple: из-за
            одного сгоревшего контроллера вам предложат заменить весь корпус с
            клавиатурой или плату целиком за 60–120 тысяч рублей. Мы находим и
            меняем саму неисправную деталь.
          </p>

          <div
            class="lr-mac-econ__compare"
            aria-label="Сравнение стоимости ремонта"
          >
            <div class="lr-mac-econ__compare-row lr-mac-econ__compare-row--bad">
              <span>Замена платы в сборе у официалов</span>
              <strong>65 000 – 120 000 ₽</strong>
              <small>Полная замена узла · ожидание 2–4 недели</small>
            </div>
            <div
              class="lr-mac-econ__compare-row lr-mac-econ__compare-row--good"
            >
              <span>Компонентный ремонт в Ленремонте</span>
              <strong>от 4 990 ₽</strong>
              <small
                >Пайка неисправного элемента за 1–3 дня · родная плата и данные
                сохраняются</small
              >
            </div>
          </div>

          <div class="lr-mac-econ__admission">
            <strong>Честное правило наших мастеров</strong>
            <p>
              Мы не ставим дешёвые безымянные копии без защиты по току. А если
