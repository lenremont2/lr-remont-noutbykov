---
import LandingLayout from "../layouts/LandingLayout.astro";
import Reviews from "../components/sections/Reviews.astro";
import QuickContacts from "../components/sections/QuickContacts.astro";
import LeadCapture from "../components/sections/LeadCapture.astro";
import LeadButton from "../components/ui/LeadButton.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import ServiceFaq from "../components/ui/ServiceFaq.astro";
import RelatedServices from "../components/ui/RelatedServices.astro";
import {
  macbook,
  macbookPrices,
  standardPrices,
  pagePath,
  getSeo,
} from "../data/service-pages";

const allPrices = [...macbookPrices, ...standardPrices];
const priceOf = (work: string) =>
  allPrices.find(([name]) => name === work)?.[1] ?? "По диагностике";

const macSymptoms = [
  {
    title: "Не включается и не реагирует на кнопку",
    price: priceOf("Ремонт платы или цепей питания"),
    time: "1–3 дня",
    image: "/media/mac-symptom-no-power.webp",
    imageAlt: "MacBook с тёмным экраном на диагностике цепей питания",
    href: "/noutbuk-ne-vklyuchaetsya.htm",
  },
  {
    title: "Залит водой, кофе или вином",
    price: priceOf("Ремонт после попадания жидкости"),
    time: "1–2 дня",
    image: "/media/mac-symptom-liquid.webp",
    imageAlt: "Пролитый кофе на клавиатуре и трекпаде MacBook",
    href: "/remont-noutbuka-posle-zalitiya.htm",
  },
  {
    title: "Разбит экран Retina или погасла подсветка",
    price: priceOf("Установка новой матрицы экрана"),
    time: "от 1 часа",
    image: "/media/mac-symptom-screen.webp",
    imageAlt: "Повреждённый экран Retina с полосами и неравномерной подсветкой",
    href: "/remont-ekrana-noutbuka.htm",
  },
  {
    title: "Вздулась батарея или быстро садится",
    price: priceOf("Замена приклеенного аккумулятора"),
    time: "1–2 дня",
    image: "/media/mac-symptom-battery.webp",
    imageAlt: "Вздувшийся аккумулятор MacBook, приподнявший стеклянный трекпад",
    href: "/noutbuk-ne-zaryazhaetsya.htm",
  },
  {
    title: "Не заряжается по USB-C или MagSafe",
    price: priceOf("Восстановление разъёма USB-C или MagSafe"),
    time: "1–2 дня",
    image: "/media/mac-symptom-charging.webp",
    imageAlt: "Подгоревшие контакты разъёма USB-C и MagSafe на корпусе MacBook",
    href: "/remont-razemov-noutbuka.htm",
  },
  {
    title: "Сильно греется и шумит вентиляторами",
    price: priceOf("Обслуживание охлаждения с полной разборкой"),
    time: "2–4 часа",
    image: "/media/mac-symptom-overheating.webp",
    imageAlt: "Забитые пылью вентиляторы охлаждения внутри открытого MacBook",
    href: "/noutbuk-peregrevaetsya.htm",
  },
  {
    title: "Залипают клавиши или не работает трекпад",
    price: priceOf("Замена клавиатуры или верхней панели"),
    time: "от 3 часов",
    image: "/media/mac-symptom-keyboard.webp",
    imageAlt: "Ремонт механизма клавиш на клавиатуре MacBook",
    href: "/remont-klaviatury-noutbuka.htm",
  },
  {
    title: "Зависает на яблоке или тормозит macOS",
    price: priceOf("Восстановление macOS с переносом данных"),
    time: "1–3 часа",
    image: "/media/mac-symptom-macos.webp",
    imageAlt:
      "Зависшая полоса загрузки macOS на экране MacBook с внешним накопителем",
    href: "/noutbuk-tormozit-ne-zagruzhaetsya.htm",
  },
];

const macTimeline = [
  {
    time: "40–90 мин",
    stage: "В день обращения",
    title: "Экспресс-диагностика, чистка охлаждения и macOS",
    desc: "При вас проверяем потребление тока по USB-C, отключаем аккумулятор при свежем залитии, очищаем радиаторы от плотного войлока и восстанавливаем загрузку macOS.",
    points: [
      "Замер линий питания без риска для данных",
      "Чистка кулеров с заменой термоинтерфейса",
      "Устранение сбоев macOS и циклической перезагрузки",
    ],
    image: "/media/repair-modular.jpg",
    imageAlt: "Инженер выполняет обслуживание и диагностику ноутбука",
  },
  {
    time: "1–2 дня",
    stage: "Модульный ремонт",
    title: "Замена аккумулятора, клавиатуры, трекпада и портов",
    desc: "Бережно демонтируем приклеенные секции батареи специальным составом без риска для шлейфа трекпада, меняем клавиатуру отдельно от топкейса и ставим новые разъёмы.",
    points: [
      "Оригинальные батареи с контролем циклов заряда",
      "Замена клавиатуры с сохранением родного корпуса",
      "Замена портов USB-C / Thunderbolt и MagSafe",
    ],
    image: "/media/repair-power.jpg",
    imageAlt: "Проверка цепей питания и разъёмов на стенде",
  },
  {
    time: "2–4 дня",
    stage: "Пайка под микроскопом",
    title: "Компонентный ремонт Logic Board и шлейфов экрана",
    desc: "Отмываем плату в ультразвуковой ванне после залития, перепаиваем сгоревшие контроллеры питания и восстанавливаем перетёртые шлейфы подсветки с проверкой под нагрузкой.",
    points: [
      "Пайка контроллеров CD3215 / CD3217 / ISL9240",
      "Восстановление шлейфа подсветки (Flexgate)",
      "Многочасовой стресс-тест стабильности после пайки",
    ],
    image: "/media/repair-bga.jpg",
    imageAlt: "Компонентная пайка платы на паяльной станции",
  },
];

const macBenefits = [
  {
    num: "01",
    title: "Сохраняем родную плату и серийный номер",
    text: "Точечная перепайка микросхем питания CD3215/CD3217, чарджеров ISL9240 и обвязки SMC обходится в 3–4 раза дешевле замены материнской платы в сборе.",
  },
  {
    num: "02",
    title: "Работают Touch ID, True Tone и датчик сна",
    text: "Датчики MacBook криптографически привязаны к плате. Сохраняя вашу родную Logic Board и перенося прошивку матриц, мы сберегаем 100% заводских функций.",
  },
  {
    num: "03",
    title: "Микропайка элементов 01005 под микроскопом",
    text: "Работаем на инфракрасных и термовоздушных станциях с контролем термопрофиля — без вздутия текстолита и перегрева соседних чипов под компаундом.",
  },
  {
    num: "04",
    title: "Эталонная сборка корпусов Unibody",
    text: "Калиброванные отвёртки Pentalobe и Torx, антистатические коврики и раскладка винтов по магнитной схеме. Никаких перепутанных винтов и бугорков на топкейсе.",
  },
  {
    num: "05",
    title: "Диагностика 0 ₽ без обязательств",
    text: "Вы узнаёте точную причину поломки и полную стоимость до начала работ. Если решите отложить ремонт — забираете собранный MacBook бесплатно.",
  },
  {
    num: "06",
    title: "Репутация Ленремонта с 1989 года",
    text: "Официальный договор с юридическим лицом, кассовый чек, возврат всех заменённых деталей и 12 месяцев прямой гарантии по наряд-заказу.",
  },
];

const macFormats = [
  {
    format: "mobile-lab",
    featured: true,
    badge: "Выезд от 45 минут",
    code: "Популярный выбор · СПб и ЛО",
    title: "Мобильная лаборатория у дома или офиса",
    text: "Оборудованный автомобиль с приборами диагностики и фирменным инструментом для техники Apple приедет по вашему адресу. Проведём проверку и модульный ремонт прямо при вас.",
    specs: [
      "Аккуратная разборка и проверка питания в вашем присутствии",
      "Экстренное отключение аккумулятора при залитии без потери времени",
      "Цены полностью совпадают с прайсом наших стационарных мастерских",
    ],
    cta: "Вызвать мобильную лабораторию",
    image: "/media/mobile-lab-exterior.webp",
    imageAlt: "Мобильная лаборатория Ленремонта у дома клиента",
    width: 480,
    height: 640,
  },
  {
    format: "workshop",
    featured: false,
    badge: "Сложная пайка плат",
    code: "Стационарный сервис",
    title: "В специализированной мастерской Ленремонта",
    text: "Оптимальный выбор для глубокого восстановления материнской платы, чистки в ультразвуковой ванне после пролитой жидкости и тонкой пайки под микроскопом.",
    specs: [
      "Инфракрасные паяльные станции, тепловизоры и стереомикроскопы",
      "Прямой приём мастером с фиксацией серийных номеров в договоре",
      "Бесплатная диагностика даже в случае отказа от ремонта",
    ],
    cta: "Подобрать удобную мастерскую",
    image: "/media/laptop-engineer-hero.webp",
    imageAlt: "Инженер Ленремонта в стационарной мастерской",
    width: 580,
    height: 384,
  },
  {
    format: "courier",
    featured: false,
    badge: "По описи и договору",
    code: "Бережная логистика",
    title: "Доставка штатным курьером туда и обратно",
    text: "Если нет времени ехать в сервис — курьер примет MacBook по акту в защитный кофр, доставит в лабораторию и вернёт полностью исправным с гарантийным талоном.",
    specs: [
      "Официальный акт приёма-передачи с описанием внешнего вида ноутбука",
      "Согласование точной цены по телефону до начала любых работ",
      "Оплата только после вашей личной проверки MacBook при получении",
    ],
    cta: "Вызвать курьера за MacBook",
    image: "/media/laptop-courier.webp",
    imageAlt: "Бережная передача ноутбука курьеру по акту",
    width: 580,
    height: 384,
  },
];

const macProcess = [
  {
    step: "01",
    duration: "За 2 минуты",
    title: "Сверка A-модели и симптомов",
    text: "Назовите пятизначный номер с нижней крышки (например, A2338) и опишите проблему. Сразу сориентируем по вилке цен и вероятному узлу сбоя.",
  },
  {
    step: "02",
    duration: "0 ₽ · 40 минут",
    title: "Аппаратная диагностика на стенде",
    text: "В лаборатории или на выезде проверяем линии питания, тестируем контроллеры USB-C и осматриваем плату под микроскопом без какой-либо оплаты.",
  },
  {
    step: "03",
    duration: "До начала пайки",
    title: "Фиксация твёрдой сметы в договоре",
    text: "До начала работ согласуем с вами итоговую сумму работы и комплектующих. Если цена не устроит — вы вправе отказаться, заплатив 0 ₽.",
  },
  {
    step: "04",
    duration: "При выдаче",
    title: "Проверка по чек-листу и гарантия 1 год",
    text: "Вместе проверяем зарядку, экран, звук, клавиатуру, Touch ID и температуру под нагрузкой. Выдаём чек, гарантийный талон и старые детали.",
  },
];

const macModels = [
  {
    family: "MacBook Air (Apple Silicon)",
    era: "2020–2024 · M1 / M2 / M3",
    codes: ["A2337", "A2681", "A2941", "A3113", "A3114"],
    focus:
      "Ремонт цепей питания и контроллеров USB-C, замена экранов Liquid Retina, спасение после залития с сохранением данных.",
  },
  {
    family: "MacBook Pro 14″ / 16″ (M-Series)",
    era: "2021–2024 · M1 / M2 / M3 Pro & Max",
    codes: ["A2442", "A2485", "A2779", "A2780", "A2918", "A2991", "A2992"],
    focus:
      "Восстановление многослойных материнских плат, ремонт разъёмов MagSafe 3 и Thunderbolt, замена дисплеев и батарей.",
  },
  {
    family: "MacBook Pro 13″ / 15″ / 16″ (Intel)",
    era: "2016–2020 · Touch Bar & Т2",
    codes: [
      "A2338",
      "A2289",
      "A2251",
      "A2141",
      "A2159",
      "A1989",
      "A1990",
      "A1706",
      "A1708",
    ],
    focus:
      "Восстановление шлейфа подсветки (Flexgate) без замены крышки, ремонт питания USB-C CD3215, замена клавиатур и батарей.",
  },
  {
    family: "MacBook Air 13″ (Intel Retina & Unibody)",
    era: "2013–2020 · MagSafe 2 & USB-C",
    codes: ["A2179", "A1932", "A1466", "A1465"],
    focus:
      "Ремонт цепей зарядки и контроллеров SMC, чистка системы охлаждения с заменой термопасты, установка новых аккумуляторов.",
  },
];
---

<LandingLayout {...getSeo(macbook)}>
  <div class="lr-mac-page">
    <div class="lr-mac-topbar">
      <Breadcrumbs current={macbook.label} />
      <div
        class="lr-container lr-mac-subnav"
        aria-label="Навигация по разделу MacBook"
      >
        <div class="lr-mac-subnav__brand">
          <span class="lr-mac-subnav__dot" aria-hidden="true"></span>
          <span class="lr-mac-subnav__tag">Apple Mac Studio · СПб</span>
        </div>
        <div class="lr-mac-subnav__links">
          <a href="#lr-symptoms">Неисправности</a>
          <a href="#lr-timeline">Сроки</a>
          <a href="#lr-benefits">Инженерия vs Замена</a>
          <a href="#lr-formats">Форматы приёма</a>
          <a href="#lr-prices">Прайс-лист</a>
          <a href="#lr-brand-guide">Инженерное досье</a>
          <a href="#lr-faq">FAQ</a>
        </div>
      </div>
    </div>

    <section
      id="lr-hero"
      class="lr-section lr-mac-hero"
      aria-labelledby="lr-hero-title"
    >
      <div class="lr-container">
        <div class="lr-mac-hero__eyebrow-bar">
          <span class="lr-mac-hero__status">
            <span class="lr-mac-hero__pulse" aria-hidden="true"></span>
            Специализированная лаборатория MacBook в Санкт-Петербурге
          </span>
          <div class="lr-mac-hero__chips" aria-label="Поддерживаемые платформы">
            <span>MacBook Air</span>
            <span>MacBook Pro</span>
            <span>Intel · T2 · M1 · M2 · M3</span>
          </div>
        </div>

        <div class="lr-mac-hero__grid">
          <div class="lr-mac-hero__main">
            <h1 id="lr-hero-title" class="lr-mac-hero__title">
              {macbook.h1}
            </h1>
            <p class="lr-mac-hero__lead">{macbook.lead}</p>

            <div class="lr-mac-hero__actions" data-lr-hero-cta>
              <LeadButton
                label="Рассчитать стоимость ремонта"
                source="brand:MacBook"
              />
              <a class="lr-mac-hero__secondary" href="#lr-prices">
                Прайс-лист по узлам
              </a>
            </div>

            <dl
              class="lr-mac-hero__metrics"
              aria-label="Ключевые стандарты сервиса"
            >
              <div class="lr-mac-hero__metric">
                <dt>0 ₽</dt>
                <dd>
                  Бесплатная диагностика даже если вы решите отложить ремонт
                </dd>
              </div>
              <div class="lr-mac-hero__metric">
                <dt>До 70%</dt>
                <dd>
                  Экономия на компонентной пайке родной платы вместо замены в
                  сборе
                </dd>
              </div>
              <div class="lr-mac-hero__metric">
                <dt>ДО работ</dt>
                <dd>
                  Фиксируем точную стоимость в официальном договоре до начала
                  ремонта
                </dd>
              </div>
              <div class="lr-mac-hero__metric">
                <dt>1 год</dt>
                <dd>
                  Прямая гарантия Ленремонта на выполненную пайку и запчасти
                </dd>
              </div>
            </dl>
          </div>

          <figure class="lr-mac-hero__showcase">
            <div class="lr-mac-hero__stage">
              <div class="lr-mac-hero__stage-bar" aria-hidden="true">
                <span class="lr-mac-hero__stage-dots">
                  <i></i><i></i><i></i>
                </span>
                <span class="lr-mac-hero__stage-label"
                  >Стенд компонентной диагностики Logic Board</span
                >
              </div>
              <img
                class="lr-mac-hero__photo"
                src="/media/mac-hero-studio.webp"
                alt="Диагностика и компонентный ремонт MacBook на антистатическом стенде Ленремонта"
                width="1080"
                height="720"
                fetchpriority="high"
                decoding="async"
              />
            </div>

            <figcaption class="lr-mac-hero__telemetry">
              <div>
                <span>Чистка и модули</span>
                <strong>40–90 минут</strong>
              </div>
              <div>
                <span>Пайка Logic Board</span>
                <strong>1–3 дня</strong>
              </div>
              <div>
                <span>Touch ID и True Tone</span>
                <strong>100% сохранение</strong>
              </div>
            </figcaption>
          </figure>
        </div>

        <QuickContacts />
      </div>
    </section>

    <section
      id="lr-symptoms"
      class="lr-section lr-mac-symptoms"
      aria-labelledby="lr-symptoms-title"
    >
      <div class="lr-container">
        <div class="lr-mac-header">
          <span class="lr-mac-eyebrow">Диагностическая матрица MacBook</span>
          <h2 id="lr-symptoms-title">
            Что случилось с вашим MacBook? Меняем только неисправную деталь, а
            не всю плату целиком
          </h2>
          <p class="lr-mac-header__lead">
            Выберите симптом вашей поломки. На бесплатной диагностике инженер
            найдёт точную причину сбоя и зафиксирует стоимость до начала работ.
          </p>
        </div>

        <div class="lr-mac-matrix">
          {
            macSymptoms.map((item) => (
              <a class="lr-mac-matrix__cell" href={item.href}>
                <img
                  class="lr-mac-matrix__image"
                  src={item.image}
                  alt={item.imageAlt}
                  width="768"
                  height="512"
                  loading="lazy"
                  decoding="async"
                />
                <div class="lr-mac-matrix__body">
                  <div class="lr-mac-matrix__top">
                    <span class="lr-mac-matrix__time">{item.time}</span>
                  </div>
                  <div class="lr-mac-matrix__bottom">
                    <h3 class="lr-mac-matrix__title">{item.title}</h3>
                    <div class="lr-mac-matrix__meta">
                      <span class="lr-mac-matrix__price">{item.price}</span>
                    </div>
                  </div>
                </div>
              </a>
            ))
          }
        </div>

        <div class="lr-mac-shield">
          <div class="lr-mac-shield__badge" aria-hidden="true">0 ₽</div>
          <div class="lr-mac-shield__copy">
            <h3>
              Щит от «выездных шантажистов»: никаких сказок про ремонт MacBook
              за 300 ₽
            </h3>
            <p>
              Типичная схема обмана на рынке: в рекламе обещают «ремонт Mac за
              350 ₽», забирают ноутбук или разбирают его на столе, а затем
              требуют 25 000–40 000 ₽ за «сложную прошивку», угрожая вернуть
              разобранный корпус. В Ленремонте вы защищены законом: диагностика
              стоит 0 ₽, точная смета фиксируется в договоре ДО начала работ, а
              оплата происходит только после вашей личной проверки MacBook.
            </p>
          </div>
          <div class="lr-mac-shield__action">
            <LeadButton
              label="Узнать честную смету по симптомам"
              source="symptoms-other"
            />
          </div>
        </div>
      </div>
    </section>

    <section
      id="lr-timeline"
      class="lr-section lr-mac-chrono"
      aria-labelledby="lr-timeline-title"
    >
      <div class="lr-container">
        <div class="lr-mac-header">
