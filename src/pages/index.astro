---
import LandingLayout from "../layouts/LandingLayout.astro";
import Hero from "../components/sections/Hero.astro";
import HomePricing from "../components/sections/HomePricing.astro";
import RepairQuiz from "../components/sections/RepairQuiz.astro";
import QuizModal from "../components/sections/QuizModal.astro";
import RepairFormats from "../components/sections/RepairFormats.astro";
import MobileLab from "../components/sections/MobileLab.astro";
import WorkshopGallery from "../components/sections/WorkshopGallery.astro";
import HomeRepairJourney from "../components/sections/HomeRepairJourney.astro";
import BusinessTrust from "../components/sections/BusinessTrust.astro";
import HomeProtection from "../components/sections/HomeProtection.astro";
import Reviews from "../components/sections/Reviews.astro";
import Locations from "../components/sections/Locations.astro";
import HomeSeo from "../components/sections/HomeSeo.astro";
import Symptoms from "../components/sections/Symptoms.astro";
import ManufacturerLinks from "../components/sections/ManufacturerLinks.astro";
import Faq from "../components/sections/Faq.astro";
import RelatedServices from "../components/ui/RelatedServices.astro";
import LeadCapture from "../components/sections/LeadCapture.astro";
import home from "../data/home-copy.json";
import { homePath } from "../data/service-pages";
---

<LandingLayout
  class="lr-home-page"
  canonical="https://www.lenremont.ru/remont-noutbukov-spb.htm"
  title="Ремонт ноутбуков в Санкт-Петербурге — цены и гарантия | Ленремонт"
  description="Ремонт ноутбуков в Санкт-Петербурге: мастерская на колёсах, сервисные центры и доставка курьером. Согласуем стоимость до ремонта. Гарантия 1 год."
>
  <Hero />
  <Symptoms
    compact
    grouped
    extraFaults
    title={home.symptoms.title}
    lead={home.symptoms.lead}
  />
  <ManufacturerLinks compact marquee />
  <RepairFormats journey />
  <Reviews scrollScene title="Отзывы наших клиентов" homeVariant />
  <HomePricing
    title={home.prices.title}
    lead={`${home.prices.lead} Указана стоимость работы без запчастей.`}
    groups={home.prices.groups}
    bonus={home.prices.bonus}
  />
  <RepairQuiz />
  <HomeRepairJourney />
  <MobileLab />
  <WorkshopGallery />
  <BusinessTrust businessOnly />
  <HomeProtection withDirector />
  <Locations />
  <!-- <RepairCases /> -->
  <HomeSeo />
  <Faq showQuestion={false} title={home.faq.title} items={home.faq.items} />
  <RelatedServices current={homePath} />
  <LeadCapture
    compactModal
    eyebrow={home.contact.eyebrow}
    title={home.contact.title}
    lead={home.contact.lead}
    messengerText={home.contact.messengerText}
    compactChannels
    scrollScene
  />
  <QuizModal />
</LandingLayout>
