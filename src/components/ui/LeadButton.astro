---
interface Props {
  label: string;
  source: string;
  format?: string;
  symptom?: string;
  text?: boolean;
  class?: string;
}
const {
  label,
  source,
  format = "consultation",
  symptom,
  text = false,
  class: className,
} = Astro.props;
---

<a
  href="#lr-contact"
  class:list={[text ? "lr-text-action" : "lr-button", className]}
  data-lr-lead-open
  data-source={source}
  data-format={format}
  data-symptom={symptom}
>
  {label}
</a>
