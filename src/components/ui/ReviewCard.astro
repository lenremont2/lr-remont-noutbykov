---
interface Props {
  plainSource?: boolean;
  review: {
    name: string;
    avatar?: string;
    rating: number;
    date: string;
    text: string;
    reviewUrl?: string;
    photos?: {
      src: string;
      alt: string;
      width: number;
      height: number;
      illustration?: boolean;
    }[];
  };
  source: { name: string; url: string; branch: string };
}
const { review, source, plainSource = false } = Astro.props;
const nameParts = review.name.trim().split(/\s+/);
const initials = (
  nameParts.length > 1
    ? nameParts
        .slice(0, 2)
        .map((part) => part[0])
        .join("")
    : review.name.trim().slice(0, 2)
).toLocaleUpperCase("ru-RU");
const longReview = review.text.length > 145;
const excerpt = review.text.slice(0, 105).replace(/\s+\S*$/, "") + "…";
---

<article class="lr-review">
  <header class="lr-review__header">
    <span class="lr-review__avatar" aria-hidden="true">
      {
        review.avatar ? (
          <img
            class="lr-review__avatar-image"
            src={review.avatar}
            alt=""
            width="44"
            height="44"
            loading="lazy"
            decoding="async"
          />
        ) : (
          initials
        )
      }
    </span>
    <div class="lr-review__author">
      <h3 class="lr-review__name">{review.name}</h3>
      <div
        class="lr-review__rating"
        role="img"
        aria-label={`Оценка ${review.rating} из 5`}
      >
        <span class="lr-review__stars" aria-hidden="true">
          {
            Array.from({ length: 5 }, (_, index) => (
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill={index < review.rating ? "currentColor" : "none"}
              >
                <path
                  d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L3 9.6l6.2-.9L12 3Z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                />
              </svg>
            ))
          }
        </span>
        <span aria-hidden="true">{review.rating}/5</span>
      </div>
    </div>
    {
      plainSource ? (
        <span class="lr-review__source">{source.name}</span>
      ) : (
        <a
          class="lr-review__source"
          href={review.reviewUrl ?? source.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Отзывы: ${review.name}, ${source.name}, ${source.branch}`}
        >
          {source.name}
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M6 18 18 6M7 6h11v11"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      )
    }
  </header>
  {
    longReview ? (
      <details class="lr-review__details">
        <summary>
          <>
            <span class="lr-review__excerpt">{excerpt}</span>
            <span class="lr-review__text lr-review__full">{review.text}</span>
            <span class="lr-review__read">Читать далее</span>
            <span class="lr-review__collapse">Свернуть отзыв</span>
          </>
        </summary>
      </details>
    ) : (
      <p class="lr-review__text">{review.text}</p>
    )
  }
  {
    review.photos?.length ? (
      <div
        class="lr-review__photos"
        role="group"
        aria-label={
          review.photos.some((photo) => photo.illustration)
            ? "Иллюстрация ремонта"
            : `Фотографии к отзыву ${review.name}`
        }
      >
        {review.photos.map((photo) => (
          <a
            class="lr-review__photo"
            data-lr-photo-open
            href={photo.src}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={
              photo.illustration
                ? `Открыть иллюстрацию: ${photo.alt}`
                : `Открыть фото к отзыву ${review.name}: ${photo.alt}`
            }
          >
            <img
              class="lr-review__photo-image"
              src={photo.src}
              alt={photo.alt
                .replace(/^Иллюстрация ремонта: /, "")
                .replace(/ \(создано с ИИ\)$/, "")}
              width={photo.width}
              height={photo.height}
              loading="lazy"
              decoding="async"
            />
          </a>
        ))}
      </div>
    ) : null
  }
</article>
