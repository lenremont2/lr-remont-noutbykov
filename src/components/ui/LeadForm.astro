---
import copy from "../../data/laptop-service.json";
import workshops from "../../data/workshops.json";
interface Props {
  id: string;
  source: string;
  submitLabel: string;
  serviceName?: string;
  requestTiming?: boolean;
  compact?: boolean;
}
const {
  id,
  source,
  submitLabel,
  serviceName = "Ремонт ноутбуков",
  requestTiming = false,
  compact = false,
} = Astro.props;
---

<div data-lead-root>
  <form
    method="post"
    class="lr-form"
    data-hop-lead-form
    data-lr-form
    data-lr-compact-form={compact || undefined}
    novalidate
  >
    <input type="hidden" name="contact_method" value="Телефон" />
    <input type="hidden" name="quiz_service" value={serviceName} />
    <input type="hidden" name="service_name" value={serviceName} />
    <input type="hidden" name="cta_source" value={source} />
    <input type="hidden" name="page_path" value="" />
    <input type="hidden" name="source" value={source} />
    <input type="hidden" name="service_format" value="consultation" />
    <input type="hidden" name="device_category" value="" />
    <input type="hidden" name="symptom" value="" />
    <div class="lr-form__context" data-lr-context hidden>
      <p data-lr-context-text></p>
      <button
        type="button"
        class="lr-text-action"
        data-lr-context-change
        aria-expanded="false"
        aria-controls={`${id}-context-picker`}>Изменить</button
      >
    </div>
    <div
      class="lr-form__context-picker"
      id={`${id}-context-picker`}
      data-lr-context-picker
      hidden
    >
      <div class="lr-form__field">
        <label for={`${id}-format`}>Формат обслуживания</label>
        <select id={`${id}-format`} data-lr-format-select>
          <option value="consultation">Помогите выбрать формат</option>
          <option value="mobile-lab">Мастерская в автомобиле у дома</option>
          <option value="at-home">Инженер в вашем помещении</option>
          <option value="workshop">В сервисном центре</option>
          <option value="courier">С доставкой курьером</option>
        </select>
      </div>
      <div class="lr-form__field" data-lr-symptom-picker>
        <label for={`${id}-symptom`}>Неисправность</label>
        <select id={`${id}-symptom`} data-lr-symptom-select>
          <option value="">Другая неисправность</option>{
            copy.symptoms.items.map((item) => (
              <option value={item.title}>{item.title}</option>
            ))
          }</select
        >
      </div>
    </div>
    <div class="lr-form__field">
      <label for={`${id}-phone`}>Ваш телефон</label>
      <input
        id={`${id}-phone`}
        name="phone"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        placeholder="+7 (___) ___-__-__"
        required
        aria-describedby={`${id}-phone-hint ${id}-phone-error`}
        data-lr-phone
      />
      <span class="lr-caption" id={`${id}-phone-hint`}
        >Перезвоним и уточним вашу задачу</span
      >
      <p class="lr-field-error" id={`${id}-phone-error`} data-lr-phone-error>
      </p>
    </div>
    <div class="lr-dialpad" data-lr-dialpad hidden>
      <div class="lr-dialpad__keys">
        {
          ["1", "2", "3", "4", "5", "6", "7", "8", "9", "clear", "0", "⌫"].map(
            (key) => (
              <button
                type="button"
                data-lr-digit={key}
                aria-label={
                  key === "⌫"
                    ? "Удалить последнюю цифру"
                    : key === "clear"
                      ? "Очистить номер полностью"
                      : key
                }
              >
                {key === "clear" ? "Сброс" : key}
              </button>
            ),
          )
        }
      </div>
    </div>
    {
      requestTiming && (
        <div class="lr-form__field">
          <label for={`${id}-timing`}>Когда нужна помощь?</label>
          <select id={`${id}-timing`} name="request_timing">
            <option value="">Уточнить при звонке</option>
            <option value="Срочно сегодня (за 1–2 часа)">
              Срочно сегодня (за 1–2 часа)
            </option>
            <option value="Сегодня вечером или завтра">
              Сегодня вечером или завтра
            </option>
            <option value="Сначала просто узнать точную цену">
              Сначала просто узнать точную цену
            </option>
          </select>
        </div>
      )
    }
    <div
      class="lr-form__field lr-form__workshop"
      data-lr-workshop-picker
      hidden
    >
      <label for={`${id}-workshop`}>Выберите мастерскую</label>
      <select id={`${id}-workshop`} name="workshop_id" disabled>
        <option value="">Помогите выбрать при звонке</option>
        {
          workshops.workshops.map((workshop) => (
            <option value={workshop.id}>
              {workshop.metro} — {workshop.address}
            </option>
          ))
        }
      </select>
      <span class="lr-caption"
        >Уточним, принимает ли выбранная мастерская вашу модель.</span
      >
    </div>
    <div class="lr-form__field lr-form__district" data-lr-district hidden>
      <label for={`${id}-district`}>Метро или район</label>
      <input
        id={`${id}-district`}
        name="district"
        placeholder="Например, Петроградская"
        disabled
      />
    </div>
    <div class="lr-form__visit" data-lr-visit-fields hidden>
      <div class="lr-form__field">
        <label for={`${id}-visit-address`} data-lr-address-label
          >Куда приехать — к дому или работе</label
        >
        <input
          id={`${id}-visit-address`}
          name="visit_address"
          type="text"
          autocomplete="street-address"
          placeholder="Населённый пункт, улица и дом"
          maxlength="240"
          aria-describedby={`${id}-visit-address-hint ${id}-visit-address-error`}
          data-lr-visit-field
          disabled
        />
        <span class="lr-caption" id={`${id}-visit-address-hint`}>
          Точный адрес и время согласуем до приезда. Квартиру и код домофона
          можно сообщить при звонке.
        </span>
        <p
          class="lr-field-error"
          id={`${id}-visit-address-error`}
          data-lr-visit-address-error
        >
        </p>
      </div>
      <div class="lr-form__field" data-lr-repair-place-field>
        <label for={`${id}-repair-place`}
          >Где вам удобнее провести ремонт?</label
        >
        <select
          id={`${id}-repair-place`}
          name="requested_repair_place"
          aria-describedby={`${id}-repair-place-hint ${id}-repair-place-error`}
          data-lr-visit-field
          disabled
        >
          <option value="">Выберите место</option>
          <option value="home">Дома</option>
          <option value="work">На работе</option>
          <option value="mobile-lab">В мастерской на колёсах</option>
          <option value="consultation">Уточнить при звонке</option>
        </select>
        <span class="lr-caption" id={`${id}-repair-place-hint`}>
          Это ваше пожелание. Возможность ремонта в выбранном месте согласуем с
          учётом неисправности и необходимого оборудования.
        </span>
        <p
          class="lr-field-error"
          id={`${id}-repair-place-error`}
          data-lr-repair-place-error
        >
        </p>
      </div>
    </div>
    <label class="lr-form__consent" for={`${id}-consent`}>
      <input
        id={`${id}-consent`}
        name="consent"
        type="checkbox"
        value="yes"
        required
        aria-describedby={`${id}-consent-error`}
      />
      <span
        >Даю согласие на обработку персональных данных.
        <a
          href="https://www.lenremont.ru/politika-obrabotki-personalnyh-dannyh.htm"
          target="_blank"
          rel="noopener noreferrer">Политика обработки данных</a
        >
      </span>
    </label>
    <p class="lr-field-error" id={`${id}-consent-error`} data-lr-consent-error>
    </p>
    <button
      class="lr-button lr-form__submit"
      type="submit"
      data-hop-lead-submit
      disabled
      >{submitLabel}
    </button>
    <p class="lr-caption lr-form__ready" data-lr-form-ready aria-live="polite">
      Введите номер телефона полностью.
    </p>
    <p
      class="lr-form__message"
      role="status"
      aria-live="polite"
      data-lr-form-message
    >
    </p>
  </form>
  <div class="lr-form__success" data-lead-success hidden role="status">
    <h3>Спасибо, ваше обращение получили</h3>
    <p>Свяжемся с вами, уточним детали и согласуем следующий шаг.</p>
    <button type="button" class="lr-button" data-lr-modal-close
      >Вернуться на страницу</button
    >
  </div>
</div>
