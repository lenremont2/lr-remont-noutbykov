---
import HomePricing from "../sections/HomePricing.astro";
interface Props {
  title: string;
  lead?: string;
  rows: string[][];
  verification?: boolean;
}
const { title, lead, rows, verification = true } = Astro.props;
---

<HomePricing
  title={title}
  lead={lead}
  groups={[{ rows }]}
  verification={verification}
/>
