---
interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
  id?: string;
}
const { title, lead, eyebrow, id } = Astro.props;
---

<div class="lr-section-heading">
  {eyebrow && <p class="lr-eyebrow">{eyebrow}</p>}
  <h2 id={id}>{title}</h2>
  {lead && <p class="lr-lead">{lead}</p>}
</div>
