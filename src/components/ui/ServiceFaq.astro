---
import Faq from "../sections/Faq.astro";
interface Props {
  items: { question: string; answer: string }[];
}
const { items } = Astro.props;
---

<Faq
  title="Вопросы перед ремонтом"
  items={items.map(({ question, answer }) => ({
    title: question,
    text: answer,
  }))}
  showQuestion={false}
/>
