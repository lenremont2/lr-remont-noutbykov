---
import LeadButton from "./LeadButton.astro";
interface Props {
  title: string;
  lead: string;
  source: string;
  image: string;
  alt: string;
  width: number;
  height: number;
  symptom?: string;
  warning?: string;
}
const { title, lead, source, image, alt, width, height, symptom, warning } =
  Astro.props;
---

<section
  id="lr-hero"
  class="lr-section lr-child-hero"
  aria-labelledby="lr-child-title"
>
  <div class="lr-container lr-child-hero__grid">
    <div class="lr-child-hero__copy">
      <h1 id="lr-child-title">{title}</h1>
      <p class="lr-lead">{lead}</p>
      {
        warning && (
          <aside class="lr-child-alert" aria-label="Важная рекомендация">
            <>
              <strong>Важно</strong>
              <p>{warning}</p>
            </>
          </aside>
        )
      }
      <div class="lr-actions" data-lr-hero-cta>
        <LeadButton
          label="Обсудить неисправность"
          source={source}
          symptom={symptom}
        />
      </div>
      <ul class="lr-child-facts">
        <li>Диагностика — 0 ₽ даже при отказе от ремонта</li>
        <li>Гарантия на ремонт 1 год</li>
        <li>Сумма согласуется до ремонта</li>
      </ul>
    </div>
    <img
      class="lr-child-hero__photo"
      src={image}
      alt={alt}
      width={width}
      height={height}
      fetchpriority="high"
      decoding="async"
    />
  </div>
</section>
