---
import LandingLayout from "../../layouts/LandingLayout.astro";
import Hero from "../sections/Hero.astro";
import Symptoms from "../sections/Symptoms.astro";
import RepairTimeline from "../sections/RepairTimeline.astro";
import Benefits from "../sections/Benefits.astro";
import RepairFormats from "../sections/RepairFormats.astro";
import RepairProcess from "../sections/RepairProcess.astro";
import SecurityRules from "../sections/SecurityRules.astro";
import Guarantee from "../sections/Guarantee.astro";
import Reviews from "../sections/Reviews.astro";
import LeadCapture from "../sections/LeadCapture.astro";
import Breadcrumbs from "../ui/Breadcrumbs.astro";
import ServicePriceTable from "../ui/ServicePriceTable.astro";
import ServiceFaq from "../ui/ServiceFaq.astro";
import RelatedServices from "../ui/RelatedServices.astro";
import {
  getSeo,
  pagePath,
  standardPrices,
  type BrandPage,
} from "../../data/service-pages";
interface Props {
  page: BrandPage;
}
const { page } = Astro.props;
---

<LandingLayout {...getSeo(page)}>
  <div class="lr-brand-page">
    <Breadcrumbs current={page.label} />
    <Hero brand={page} />
    <Symptoms />
    <RepairTimeline />
    <Benefits />
    <RepairFormats linkToLocations={false} />
    <RepairProcess />
    <SecurityRules />
    <Guarantee />
    <Reviews />
    <ServicePriceTable
      title={"Стоимость работ по ремонту " + page.label}
      rows={standardPrices}
    />
    <section
      id="lr-brand-guide"
      class="lr-section lr-brand-guide"
      aria-labelledby="lr-brand-guide-title"
    >
      <div class="lr-container">
        <div class="lr-section-heading">
          <p class="lr-eyebrow">О ремонте {page.label}</p>
          <h2 id="lr-brand-guide-title">{page.sectionTitle}</h2>
          <p class="lr-lead">{page.intro}</p>
        </div>
        <div class="lr-brand-guide__checks">
          {
            page.checks.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))
          }
        </div>
        <details class="lr-brand-guide__prepare">
          <summary>Что подготовить к обращению</summary>
          <ul class="lr-child-list">
            {page.prepare.map((text) => <li>{text}</li>)}
          </ul>
        </details>
      </div>
    </section>
    <ServiceFaq items={page.faq} />
    <RelatedServices current={pagePath(page)} />
    <LeadCapture
      title={"Зафиксируйте бесплатную экспресс-диагностику и скидку 15% на ремонт " +
        page.label}
      lead="Назовите модель и симптомы поломки. Инженер согласует смету ДО начала работ. Если цена вас не устроит — отказ без каких-либо оплат."
      serviceName={"Ремонт ноутбуков " + page.label}
    />
  </div>
</LandingLayout>
