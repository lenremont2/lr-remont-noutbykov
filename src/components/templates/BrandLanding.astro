---
import LandingLayout from "../../layouts/LandingLayout.astro";
import Hero from "../sections/Hero.astro";
import Symptoms from "../sections/Symptoms.astro";
import RepairFormats from "../sections/RepairFormats.astro";
import HomePricing from "../sections/HomePricing.astro";
import RepairQuiz from "../sections/RepairQuiz.astro";
import QuizModal from "../sections/QuizModal.astro";
import HomeRepairJourney from "../sections/HomeRepairJourney.astro";
import MobileLab from "../sections/MobileLab.astro";
import WorkshopGallery from "../sections/WorkshopGallery.astro";
import BusinessTrust from "../sections/BusinessTrust.astro";
import Locations from "../sections/Locations.astro";
import HomeProtection from "../sections/HomeProtection.astro";
import Reviews from "../sections/Reviews.astro";
import LeadCapture from "../sections/LeadCapture.astro";
import Breadcrumbs from "../ui/Breadcrumbs.astro";
import Faq from "../sections/Faq.astro";
import RelatedServices from "../ui/RelatedServices.astro";
import home from "../../data/home-copy.json";
import { getSeo, pagePath, type BrandPage } from "../../data/service-pages";
interface Props {
  page: BrandPage;
}
const { page } = Astro.props;
---

<LandingLayout {...getSeo(page)}>
  <div class="lr-brand-page">
    <Breadcrumbs current={page.label} />
    <Hero brand={page} variant="home" />
    <Symptoms
      compact
      grouped
      extraFaults
      title={`Неисправности ноутбуков ${page.label}`}
      lead={home.symptoms.lead}
    />
    <RepairFormats journey />
    <Reviews scrollScene title="Отзывы наших клиентов" homeVariant />
    <HomePricing
      title={`Сколько стоит ремонт ноутбука ${page.label}`}
      lead={`${home.prices.lead} Указана стоимость работы без запчастей.`}
      groups={[{ ...home.prices.groups[0], title: `Ноутбуки ${page.label}` }]}
      bonus={home.prices.bonus}
    />
    <RepairQuiz brand={page} />
    <HomeRepairJourney />
    <MobileLab />
    <WorkshopGallery />
    <BusinessTrust businessOnly />
    <HomeProtection withDirector />
    <Locations />
    <section
      id="lr-brand-guide"
      class="lr-section lr-brand-guide"
      aria-labelledby="lr-brand-guide-title"
    >
      <div class="lr-container">
        <div class="lr-section-heading">
          <h2 id="lr-brand-guide-title">{page.sectionTitle}</h2>
          <p class="lr-lead">{page.intro}</p>
        </div>
        <div class="lr-brand-guide__checks">
          {
            page.checks.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))
          }
        </div>
        <details class="lr-brand-guide__prepare">
          <summary>Что подготовить к обращению</summary>
          <ul class="lr-child-list">
            {page.prepare.map((text) => <li>{text}</li>)}
          </ul>
        </details>
      </div>
    </section>
    <Faq
      showQuestion={false}
      title={`Вопросы о ремонте ноутбуков ${page.label}`}
      items={page.faq.map(({ question, answer }) => ({
        title: question,
        text: answer,
      }))}
    />
    <RelatedServices current={pagePath(page)} />
    <LeadCapture
      compactModal
      compactChannels
      scrollScene
      eyebrow={home.contact.eyebrow}
      messengerText={home.contact.messengerText}
      title={page.contactTitle ??
        "Обсудим неисправность и стоимость ремонта " + page.label}
      lead={page.contactLead ??
        "Назовите модель и симптомы. Уточним удобный способ передачи ноутбука, а после диагностики согласуем работы и полную стоимость."}
      serviceName={"Ремонт ноутбуков " + page.label}
    />
    <QuizModal />
  </div>
</LandingLayout>
