---
import copy from "../../data/laptop-service.json";
import SectionHeading from "../ui/SectionHeading.astro";
import DirectorMessage from "./DirectorMessage.astro";
import home from "../../data/home-copy.json";

interface Props {
  securityAnchor?: boolean;
  withDirector?: boolean;
}
const { securityAnchor = true, withDirector = false } = Astro.props;
const g = copy.guarantee;
const facts = withDirector
  ? home.guarantees.items
  : [
      {
        value: "",
        title: g.fields["Большой факт"],
        text: "Гарантии на ремонт и установленные запчасти.",
      },
      {
        value: "",
        title: "Смета до работ",
        text: "Стоимость работ и деталей согласуем заранее.",
      },
      {
        value: "",
        title: "Проверка до оплаты",
        text: "Покажем результат и проверим ноутбук вместе с вами.",
      },
    ];
---

<section
  id="lr-guarantee"
  class:list={[
    "lr-section lr-home-protection",
    { "lr-home-protection--combined": withDirector },
  ]}
>
  <div class="lr-container">
    <SectionHeading
      title={withDirector
        ? home.guarantees.title
        : "Гарантия и порядок ремонта"}
    />
    <div
      id={securityAnchor ? "lr-security" : undefined}
      class="lr-home-protection__facts"
    >
      {
        facts.map((fact) => (
          <article>
            {withDirector && (
              <span class="lr-home-protection__value">{fact.value}</span>
            )}
            <h3>{fact.title}</h3>
            <p>{fact.text}</p>
          </article>
        ))
      }
    </div>
    {withDirector && <DirectorMessage compact />}
  </div>
</section>
