---
import copy from "../../data/laptop-service.json";
import SectionHeading from "../ui/SectionHeading.astro";
import DirectorMessage from "./DirectorMessage.astro";
import home from "../../data/home-copy.json";

interface Props {
  securityAnchor?: boolean;
  withDirector?: boolean;
}
const { securityAnchor = true, withDirector = false } = Astro.props;
const g = copy.guarantee;
const factIcons = [
  "M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2ZM8 6h8v4H8zM8 14h1m3 0h1m3 0h.01M8 18h1m3 0h1m3 0h.01",
  "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6ZM14 2v6h6M8 13h8m-8 4h5",
  "M5 3h14a1 1 0 0 1 1 1v11H4V4a1 1 0 0 1 1-1ZM4 15l-3 5h22l-3-5M9 20h6M8 8l3 3 5-5",
];
const facts = withDirector
  ? [
      home.guarantees.items[1],
      home.guarantees.items[0],
      ...home.guarantees.items.slice(2),
    ]
  : [
      {
        value: "",
        title: g.fields["Большой факт"],
        text: "Гарантии на ремонт и установленные запчасти.",
      },
      {
        value: "",
        title: "Смета до работ",
        text: "Стоимость работ и деталей согласуем заранее.",
      },
      {
        value: "",
        title: "Проверка до оплаты",
        text: "Покажем результат и проверим ноутбук вместе с вами.",
      },
    ];
---

<section
  id="lr-guarantee"
  class:list={[
    "lr-section lr-home-protection",
    { "lr-home-protection--detailed": withDirector },
  ]}
  aria-labelledby="lr-guarantee-title"
>
  <div class="lr-container">
    <SectionHeading
      id="lr-guarantee-title"
      title={withDirector
        ? home.guarantees.title
        : "Гарантия и порядок ремонта"}
      lead={withDirector
        ? "Условия ремонта и гарантии фиксируем в документах. Вы получаете кассовый чек, договор и гарантийный талон."
        : undefined}
    />
    <div
      id={securityAnchor ? "lr-security" : undefined}
      class="lr-home-protection__facts"
    >
      {
        facts.map((fact, index) => (
          <article>
            {withDirector && index === 0 && (
              <span class="lr-home-protection__value">{fact.value}</span>
            )}
            {withDirector && index > 0 && (
              <span class="lr-home-protection__icon" aria-hidden="true">
                <svg
                  width="48"
                  height="48"
                  viewBox="0 0 24 24"
                  fill="none"
                  focusable="false"
                >
                  <path
                    d={factIcons[index - 1]}
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            )}
            <h3>{fact.title}</h3>
            <p>{fact.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

{withDirector && <DirectorMessage />}
