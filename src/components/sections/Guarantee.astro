---
import copy from "../../data/laptop-service.json";
import GuaranteeSupport from "../ui/GuaranteeSupport.astro";
const c = copy.guarantee;
const refund = copy.benefits.items[2];
---

<section id="lr-guarantee" class="lr-section lr-guarantee">
  <div class="lr-container">
    <div class="lr-guarantee__grid">
      <div>
        <p class="lr-eyebrow">{c.fields["Надзаголовок"]}</p>
        <h2>Гарантия на ремонт и установленные запчасти</h2>
        <div class="lr-guarantee__fact">
          <strong>{c.fields["Большой факт"]}</strong>
          <p>{c.fields["Подпись факта"]}</p>
        </div>
        <p class="lr-lead">
          Выполненные работы и условия гарантии фиксируем в документах о
          ремонте.
        </p>
      </div>
      <div class="lr-guarantee__conditions">
        <article>
          <span class="lr-guarantee__condition-label">После ремонта</span>
          <h3>Что покрывает гарантия</h3>
          <p>{c.items[0].text}</p>
        </article>
        <article>
          <span class="lr-guarantee__condition-label">До начала работ</span>
          <h3>Стоимость согласована заранее</h3>
          <p>{c.items[1].text}</p>
        </article>
        <article>
          <span class="lr-guarantee__condition-label"
            >Если результат не устроил</span
          >
          <h3>{refund.title}</h3>
          <p>{refund.text}</p>
        </article>
      </div>
    </div>
    <GuaranteeSupport />
  </div>
</section>
