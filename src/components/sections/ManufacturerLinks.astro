---
import { brands, macbook, pagePath } from "../../data/service-pages";
import SectionHeading from "../ui/SectionHeading.astro";

const marks: Record<string, string> = {
  Acer: "acer",
  ASUS: "asus",
  Dell: "dell",
  HP: "hp",
  Lenovo: "lenovo",
  MSI: "msi",
  Samsung: "samsung",
  "Sony VAIO": "sony",
  Toshiba: "toshiba",
  MacBook: "apple",
};
const manufacturers = [...brands, macbook];
const featuredManufacturers = manufacturers.filter((page) => marks[page.label]);
const otherManufacturers = manufacturers
  .filter((page) => !marks[page.label])
  .sort((a, b) =>
    a.label.localeCompare(b.label, "ru", { sensitivity: "base" }),
  );
---

<section id="lr-manufacturers" class="lr-section lr-manufacturers">
  <div class="lr-container">
    <SectionHeading
      title="Ремонт ноутбуков разных производителей"
      lead="Выберите марку, чтобы узнать об особенностях ремонта вашего ноутбука."
    />
    <ul class="lr-manufacturers__list">
      {
        featuredManufacturers.map((page) => (
          <li>
            <a class="lr-manufacturers__link" href={pagePath(page)}>
              <img
                src={`/media/manufacturer-${marks[page.label]}.svg`}
                alt=""
                width="128"
                height="48"
                loading="lazy"
              />
              <span>{page.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
    {
      otherManufacturers.length > 0 && (
        <div class="lr-manufacturers__other">
          <h3 id="lr-other-manufacturers-title">Другие производители</h3>
          <ul
            class="lr-manufacturers__other-list"
            aria-labelledby="lr-other-manufacturers-title"
          >
            {otherManufacturers.map((page) => (
              <li>
                <a class="lr-manufacturers__text-link" href={pagePath(page)}>
                  {page.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
