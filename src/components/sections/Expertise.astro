---
import copy from "../../data/laptop-service.json";
import SectionHeading from "../ui/SectionHeading.astro";
import LeadButton from "../ui/LeadButton.astro";
import { brands, macbook, pagePath } from "../../data/service-pages";
const c = copy.expertise;
const f = c.items[2].fields;
---

<section id="lr-expertise" class="lr-section lr-expertise">
  <div class="lr-container">
    <div class="lr-expertise__grid">
      <figure>
        <img
          src="/media/laptop-board-diagnostics.webp"
          alt="Проверка платы ноутбука"
          width="580"
          height="384"
          loading="lazy"
        />
        <figcaption>{f["Подпись к фото"]}</figcaption>
      </figure>
      <div>
        <SectionHeading
          title={c.fields.H2}
          lead={c.fields["Лид"]}
          eyebrow={c.fields["Надзаголовок"]}
        />
        <div class="lr-editorial-list">
          {
            c.items.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))
          }
        </div>
        <LeadButton label={f.CTA!} source="expertise" text />
      </div>
    </div>
    <div class="lr-brands">
      <h3>{f["Подзаголовок брендов"]}</h3>
      <ul class="lr-brand-links">
        {
          [...brands, macbook].map((page) => (
            <li>
              <a href={pagePath(page)}>{page.label}</a>
            </li>
          ))
        }
      </ul>
      <p class="lr-caption">{f["Текст"]}</p>
    </div>
  </div>
</section>
