---
import copy from "../../data/laptop-service.json";
import SectionHeading from "../ui/SectionHeading.astro";
import LeadButton from "../ui/LeadButton.astro";
import { pagePath } from "../../data/service-pages";
const c = copy.symptoms;
const prices = copy.prices.tables.flat();
---

<section id="lr-symptoms" class="lr-section lr-symptoms">
  <div class="lr-container">
    <SectionHeading title={c.fields.H2} lead={c.fields["Лид"]} />
    <div class="lr-symptoms__grid">
      {
        c.items.map((item) => (
          <a class="lr-symptom" href={pagePath(item)}>
            <img
              class="lr-symptom__image"
              src={item.image}
              alt={item.imageAlt}
              width="768"
              height="512"
              loading="lazy"
              decoding="async"
            />
            <div class="lr-symptom__body">
              <h3>{item.title}</h3>
              <p class="lr-symptom__price">
                {prices.find(([work]) => work === item.priceWork)?.[1] ??
                  "Бесплатная диагностика"}
              </p>
            </div>
          </a>
        ))
      }
    </div>
    <div class="lr-section-note">
      <p>
        В рекламе часто обещают «выезд 0 ₽, ремонт от 200 ₽», а после разборки
        требуют 15 000–25 000 ₽ за сборку. В Ленремонте вы защищены официальным
        договором: точная смета фиксируется ДО начала работ, оплата — строго
        после вашей проверки, а все заменённые детали возвращаются вам.
      </p>
      <LeadButton label="Узнать стоимость ремонта" source="symptoms-other" />
    </div>
  </div>
</section>
