---
import copy from "../../data/laptop-service.json";
const c = copy.faq;
interface Props {
  showQuestion?: boolean;
  title?: string;
  items?: { title: string; text: string }[];
}
const {
  showQuestion = true,
  title = c.fields.H2,
  items = c.items,
} = Astro.props;
---

<section id="lr-faq" class="lr-section lr-faq-section">
  <div class="lr-container lr-faq">
    <h2>{title}</h2>
    <div>
      {
        items.map((item) => (
          <details class="lr-faq__item">
            <summary>
              {item.title}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{item.text}</p>
          </details>
        ))
      }{
        showQuestion && (
          <div class="lr-faq__question">
            <p>{c.items[7].fields["Текст после FAQ"]}</p>
            <a class="lr-text-action" href="#lr-contact" data-lr-question>
              {c.items[7].fields.CTA}
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>
