---
import copy from "../../data/laptop-service.json";
import SectionHeading from "../ui/SectionHeading.astro";
import LeadButton from "../ui/LeadButton.astro";

interface Props {
  linkToLocations?: boolean;
  compact?: boolean;
}
const { linkToLocations = true, compact = true } = Astro.props;
const c = copy.formats;
const compactImages = {
  "at-home": "/media/format-home-v4-1280.webp",
  "mobile-lab": "/media/format-mobile-v4-1280.webp",
  workshop: "/media/format-workshop-v4-1280.webp",
  courier: "/media/format-courier-v4-1280.webp",
};
const formatMeta = {
  "at-home": {
    image: "/media/laptop-board-diagnostics.webp",
    alt: "Диагностика ноутбука инженером",
    width: 580,
    height: 384,
    features: [
      "Место и время согласуем до выезда",
      "Возможность работ зависит от модели и неисправности",
      "Если нужен сервис, обсудим передачу устройства",
    ],
  },
  "mobile-lab": {
    image: "/media/mobile-lab-exterior.webp",
    alt: "Мобильная мастерская Ленремонта",
    width: 480,
    height: 640,
    features: [
      "Оборудованное место внутри автомобиля",
      "Подъезд к дому или работе согласуем заранее",
      "Состав и стоимость работ подтвердим до ремонта",
    ],
  },
  workshop: {
    image: "/media/laptop-engineer-hero.webp",
    alt: "Инженер за работой в сервисном центре",
    width: 580,
    height: 384,
    features: [
      "Выберите адрес и проверьте режим работы",
      "Диагностика 0 ₽ даже при отказе от ремонта",
      "Диагностика и ремонт на стационарном оборудовании",
    ],
  },
  courier: {
    image: "/media/laptop-courier.webp",
    alt: "Курьерская доставка ноутбука в сервисный центр",
    width: 580,
    height: 384,
    features: [
      "Согласованный интервал приезда курьера",
      "Документ при передаче устройства",
      "Оплата после проверки готового ноутбука",
    ],
  },
};
const compactFeatures = {
  "at-home": ["Выезд в удобное время", "Возможность ремонта уточним по модели"],
  "mobile-lab": [
    "Рабочее место — в автомобиле",
    "Подъезд и работы согласуем заранее",
  ],
  workshop: ["Диагностика — 0 ₽, даже при отказе", "Стационарное оборудование"],
  courier: [
    "Заберём ноутбук по документу",
    "Время и условия доставки согласуем",
  ],
};
---

<section
  id="lr-formats"
  class:list={["lr-section lr-formats", { "lr-formats--compact": compact }]}
>
  <div class="lr-container">
    <SectionHeading
      title={compact ? "Способы ремонта" : c.fields.H2}
      lead={compact
        ? "Выберите удобный способ ремонта. Детали и стоимость согласуем заранее."
        : c.fields["Лид"]}
    />
    <div class="lr-formats__grid">
      {
        c.items.map((item) => {
          const meta = formatMeta[item.format as keyof typeof formatMeta];
          const isFeatured = item.format === "mobile-lab";
          return (
            <article
              class:list={["lr-format", isFeatured && "lr-format--featured"]}
            >
              <figure class="lr-format__media">
                <img
                  src={
                    compact
                      ? compactImages[item.format as keyof typeof compactImages]
                      : meta.image
                  }
                  alt={
                    compact
                      ? `Иллюстрация: ${meta.alt.toLocaleLowerCase("ru-RU")}`
                      : meta.alt
                  }
                  width={compact ? 1280 : meta.width}
                  height={compact ? 720 : meta.height}
                  loading="lazy"
                  decoding="async"
                />
                {!compact && <figcaption>{item.fields["Акцент"]}</figcaption>}
              </figure>
              <div class="lr-format__body">
                <h3 class="lr-format__title">{item.title}</h3>
                {!compact && <p class="lr-format__text">{item.text}</p>}
                <ul class="lr-format__features">
                  {(compact
                    ? compactFeatures[
                        item.format as keyof typeof compactFeatures
                      ]
                    : meta.features
                  ).map((feature) => (
                    <li>
                      {compact && (
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 16 16"
                          fill="none"
                          aria-hidden="true"
                        >
                          <path
                            d="m3 8 3 3 7-7"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      )}
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
                <div class="lr-format__footer">
                  {linkToLocations && item.format === "workshop" ? (
                    <a
                      class="lr-text-action lr-format__btn"
                      href="#lr-map-workshops"
                    >
                      {item.fields.CTA}
                      <span aria-hidden="true">→</span>
                    </a>
                  ) : linkToLocations && item.format === "courier" ? (
                    <LeadButton
                      label={item.fields.CTA}
                      source="formats:courier"
                      format="courier"
                      text
                      class="lr-format__btn"
                    />
                  ) : (
                    <LeadButton
                      label={item.fields.CTA}
                      source="formats"
                      format={item.format}
                      text={compact || !isFeatured}
                      class="lr-format__btn"
                    />
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
    {
      !compact && (
        <div class="lr-formats__trust">
          <p>
            <strong>Диагностика в мастерской — 0 ₽.</strong> Даже при отказе от
            ремонта.
          </p>
          <p>
            <strong>Гарантия 1 год.</strong> Фиксируем все работы в документах.
          </p>
          <p>
            <strong>Круглосуточный приём.</strong> Консультируем без выходных
            24/7.
          </p>
        </div>
      )
    }
  </div>
</section>
