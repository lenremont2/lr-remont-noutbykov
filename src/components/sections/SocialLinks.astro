---

<div class="lr-social-links">
  <h3>{title}</h3>
  {text && <p class="lr-caption">{text}</p>}
  <ul class="lr-social-links__list">
    {
      channels.map((channel) => (
        <li class="lr-social-links__channel">
          <a
            class={`lr-social-links__button lr-social-links__button--${channel.id}`}
            href={channel.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Написать ${channel.id === "vk" ? "во" : "в"} ${channel.label}`}
          >
            <span
              class="lr-social-links__icon"
              style={`--lr-social-color: ${channel.color};`}
              aria-hidden="true"
            >
              <svg viewBox={channel.viewBox}>
                <path
                  d={channel.iconPath}
                  stroke={channel.strokeWidth ? "currentColor" : undefined}
                  stroke-width={channel.strokeWidth}
                  fill-rule={channel.fillRule}
                  clip-rule={channel.clipRule}
                />
              </svg>
            </span>
            <span>{channel.label}</span>
          </a>
          {channel.qrSrc && (
            <details
              class="lr-social-links__qr-disclosure"
              data-lr-qr-disclosure
              open
            >
              <summary>
                QR-код <span aria-hidden="true">+</span>
              </summary>
              <a
                class={"lr-social-links__qr lr-social-links__qr--" + channel.id}
                href={channel.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Открыть ${channel.label} Ленремонта`}
              >
                <img
                  src={channel.qrSrc}
                  alt={`QR-код ${channel.label} Ленремонта`}
                  width="256"
                  height="256"
                  loading="lazy"
                />
              </a>
            </details>
          )}
        </li>
      ))
    }
  </ul>
</div>
