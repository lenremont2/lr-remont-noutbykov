---
import SectionHeading from "../ui/SectionHeading.astro";
import LeadButton from "../ui/LeadButton.astro";
import DirectorSignature from "../ui/DirectorSignature.astro";
import home from "../../data/home-copy.json";
const paragraphs = home.director.quote.split(/(?<=\.)\s+/);
---

<section
  id="lr-director"
  class="lr-section lr-director"
  aria-labelledby="lr-director-title"
>
  <div class="lr-container lr-director__grid">
    <div class="lr-director__identity">
      <figure class="lr-director__photo">
        <img
          src="/media/director-sorokin-640.webp"
          srcset="/media/director-sorokin-320.webp 320w, /media/director-sorokin-640.webp 640w"
          sizes="(min-width: 1440px) 512px, (min-width: 768px) 36vw, calc(100vw - 40px)"
          width="640"
          height="820"
          alt="Денис Сорокин, директор Ленремонта"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="lr-director__caption">
        <p class="lr-director__name">Денис Сорокин</p>
        <p class="lr-caption">Директор Ленремонта</p>
      </div>
    </div>
    <div class="lr-director__copy">
      <SectionHeading
        id="lr-director-title"
        eyebrow="Обращение директора"
        title={home.director.title}
      />
      <blockquote class="lr-director__message">
        {
          paragraphs.map((paragraph, index) => (
            <p>
              {index === 0 ? (
                <strong class="lr-director__principle">{paragraph}</strong>
              ) : (
                paragraph
              )}
            </p>
          ))
        }
      </blockquote>
      <div class="lr-director__action">
        <DirectorSignature />
        <LeadButton label="Обсудить ремонт ноутбука" source="director" />
      </div>
    </div>
  </div>
</section>
