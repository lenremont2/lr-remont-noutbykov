---
import copy from "../../data/laptop-service.json";
import SectionHeading from "../ui/SectionHeading.astro";
const c = copy.prices;
const note = c.items[2].fields;
---

<section id="lr-prices" class="lr-section lr-prices">
  <div class="lr-container">
    <SectionHeading title={c.fields.H2} />
    <table
      class="lr-price-table lr-price-table--with-time"
      aria-label="Цены и ориентировочное время ремонта ноутбуков и MacBook"
    >
      <thead>
        <tr>
          <th scope="col">Работа</th>
          <th scope="col" class="lr-price-table__duration col-left"
            >Время работы</th
          >
          <th scope="col" class="col-left">Стоимость работы</th>
        </tr>
      </thead>
      {
        [c.fields["Категория 1"], c.fields["Категория 2"]].map(
          (category, i) => (
            <tbody>
              <tr class="lr-price-group">
                <th scope="rowgroup" colspan="3">
                  {category}
                </th>
              </tr>
              {(i ? c.tables[2] : [...c.tables[0], ...c.tables[1]]).map(
                ([work, price, duration]) => (
                  <tr>
                    <th scope="row">
                      {work}
                      <span class="lr-price-table__time-inline">
                        Время: {duration}
                      </span>
                    </th>
                    <td class="lr-price-table__duration">{duration}</td>
                    <td>{price}</td>
                  </tr>
                ),
              )}
            </tbody>
          ),
        )
      }
    </table>
    <p class="lr-caption lr-prices__note">
      {note["Пояснение под таблицей"]}
      {note["Строка диагностики"]}
    </p>
    <p class="lr-caption lr-prices__note">
      Время указано ориентировочно по открытым данным сервисов Санкт-Петербурга.
      Срок ремонта в Ленремонте согласуем после диагностики: он зависит от
      модели, неисправности и наличия деталей. Время переноса системы и файлов
      зависит от объёма данных и состояния накопителя. Диагностика, доставка и
      ожидание запчастей согласуются отдельно.
    </p>
  </div>
</section>
