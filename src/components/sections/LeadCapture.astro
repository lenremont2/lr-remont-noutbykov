---
import copy from "../../data/laptop-service.json";
import LeadForm from "../ui/LeadForm.astro";
import LeadModal from "../ui/LeadModal.astro";
import SocialLinks from "./SocialLinks.astro";
const c = copy.contact.fields;
interface Props {
  title?: string;
  lead?: string;
  serviceName?: string;
}
const {
  title = c.H2,
  lead = c["Лид"],
  serviceName = "Ремонт ноутбуков",
} = Astro.props;
---

<section id="lr-contact" class="lr-section lr-contact">
  <div class="lr-container lr-contact__grid">
    <div class="lr-contact__copy">
      <p class="lr-eyebrow">{c["Надзаголовок"]}</p>
      <h2>{title}</h2>
      <p class="lr-lead">{lead}</p>
    </div>
    <div class="lr-contact__form">
      <h3>{c["Заголовок формы"]}</h3>
      <LeadForm
        id="lr-contact-form"
        source="contact"
        serviceName={serviceName}
        submitLabel="Узнать стоимость ремонта"
      />
    </div>
    <div class="lr-contact__channels">
      <p class="lr-caption">{c["Подпись телефона"]}</p>
      <a class="lr-contact__phone" href="tel:+78123444444">{c["Телефон"]}</a>
      <p class="lr-caption">{c["Подпись режима"]}</p>
    </div>
    <SocialLinks />
  </div>
</section>
<LeadModal
  id="lead"
  title="Узнайте стоимость ремонта"
  closeLabel="Закрыть форму"
>
  <p class="lr-modal__intro" data-lr-modal-intro>
    Оставьте номер — уточним модель и симптомы, сориентируем по цене. Полную
    стоимость согласуем после диагностики.
  </p>
  <LeadForm
    id="lr-modal-form"
    source="hero"
    serviceName={serviceName}
    submitLabel="Узнать стоимость ремонта"
  />
</LeadModal>
<div class="lr-mobile-bar" data-lr-mobile-bar hidden>
  <a
    class="lr-mobile-bar__call"
    href="tel:+78123444444"
    aria-label="Позвонить в Ленремонт">Позвонить</a
  >
  <a
    class="lr-button"
    href="#lr-contact"
    data-lr-lead-open
    data-source="mobile-bar"
    aria-label="Узнать стоимость ремонта ноутбука">Узнать стоимость</a
  >
</div>
