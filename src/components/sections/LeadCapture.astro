---
import copy from "../../data/laptop-service.json";
import LeadForm from "../ui/LeadForm.astro";
import LeadModal from "../ui/LeadModal.astro";
import MapSlot from "../ui/MapSlot.astro";
import SocialLinks from "./SocialLinks.astro";
const c = copy.contact.fields;
interface Props {
  title?: string;
  lead?: string;
  serviceName?: string;
  compactChannels?: boolean;
  scrollScene?: boolean;
  eyebrow?: string;
  messengerText?: string;
  compactModal?: boolean;
}
const {
  title = c.H2,
  lead = c["Лид"],
  serviceName = "Ремонт ноутбуков",
  compactChannels = true,
  scrollScene = false,
  eyebrow,
  messengerText = "",
  compactModal = false,
} = Astro.props;
---

<section
  id="lr-contact"
  class="lr-section lr-contact"
  data-sc-act={scrollScene ? "flow" : undefined}
>
  <div class="lr-container lr-contact__grid">
    <div class="lr-contact__copy">
      {eyebrow && <p class="lr-eyebrow">{eyebrow}</p>}
      <h2>{title}</h2>
      <p class="lr-lead">{lead}</p>
    </div>
    <div class="lr-contact__form">
      <h3>{c["Заголовок формы"]}</h3>
      <LeadForm
        id="lr-contact-form"
        source="contact"
        serviceName={serviceName}
        submitLabel="Узнать стоимость ремонта"
      />
    </div>
    <div class="lr-contact__channels">
      <p class="lr-caption">
        {compactChannels ? "Позвоните нам по телефону" : c["Подпись телефона"]}
      </p>
      <a class="lr-contact__phone" href="tel:+78123444444">{c["Телефон"]}</a>
      {!compactChannels && <p class="lr-caption">{c["Подпись режима"]}</p>}
    </div>
    {
      compactChannels ? (
        <SocialLinks
          title="Или напишите нам в мессенджере"
          text={messengerText}
        />
      ) : (
        <SocialLinks />
      )
    }
  </div>
</section>
<LeadModal
  id="lead"
  compact={compactModal}
  title="Узнайте стоимость ремонта"
  closeLabel="Закрыть форму"
>
  <p class="lr-modal__intro" data-lr-modal-intro>
    Оставьте номер — уточним модель и симптомы, сориентируем по цене. Полную
    стоимость согласуем после диагностики.
  </p>
  <LeadForm
    id="lr-modal-form"
    source="hero"
    serviceName={serviceName}
    submitLabel="Узнать стоимость ремонта"
    compact={compactModal}
  />
</LeadModal>
<LeadModal id="map" title="Выберите мастерскую" closeLabel="Закрыть карту">
  <div data-lr-map-view="workshops">
    <MapSlot id="lr-map-workshops-modal" type="workshops" />
  </div>
  <div data-lr-map-view="address" hidden>
    <MapSlot id="lr-map-address" type="address" />
  </div>
</LeadModal>
