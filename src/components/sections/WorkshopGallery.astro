---
import SectionHeading from "../ui/SectionHeading.astro";
import home from "../../data/home-copy.json";
const photos = [
  "workshop-v5-soldering-1280.webp",
  "workshop-v4-diagnostics-1280.webp",
  "workshop-v4-parts-1280.webp",
  "workshop-v4-testing-1280.webp",
];
---

<section
  id="lr-workshop-gallery"
  class="lr-section lr-equipment-reference"
  data-lr-swipe-slider
>
  <div class="lr-container">
    <SectionHeading
      title={home.equipment.title}
      lead={home.equipment.lead}
      eyebrow="Стационарная лабораторная база"
    />
    <div
      class="lr-equipment-reference__track lr-swipe-track"
      data-lr-swipe-track
      tabindex="0"
      role="region"
      aria-label="Оборудование и рабочие зоны"
      aria-roledescription="карусель"
    >
      {
        home.equipment.items.map((item, index) => (
          <article class="lr-equipment-reference__card">
            <a
              href={"/media/" + photos[index]}
              data-lr-photo-open
              aria-label={"Увеличить фото: " + item.title}
            >
              <img
                src={"/media/" + photos[index]}
                alt={item.title}
                width="1280"
                height="720"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
