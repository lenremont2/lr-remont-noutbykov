---
import copy from "../../data/laptop-service.json";
import SectionHeading from "../ui/SectionHeading.astro";
import LeadButton from "../ui/LeadButton.astro";
import home from "../../data/home-copy.json";
const c = copy.lab;
const f = c.items[2].fields;
---

<section id="lr-lab" class="lr-section lr-lab">
  <div class="lr-container">
    <div class="lr-lab__stage">
      <figure class="lr-lab__media" data-lr-video-player>
        <video
          class="lr-lab__video"
          data-lr-player-video
          width="720"
          height="720"
          controls
          playsinline
          preload="none"
          poster="/media/workshop-mobile-engineer-720.webp"
          aria-label="Мастерская на колёсах: рабочее место инженера"
        >
          <source src="/media/mobile-lab-tour.mp4" type="video/mp4" />
          <a href="/media/mobile-lab-tour.mp4">Открыть видео мастерской</a>
        </video>
        <button
          class="lr-lab__play"
          type="button"
          data-lr-player-play
          hidden
          aria-label="Смотреть обзор мастерской"
        >
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"><path d="M8 4.5v15l12-7.5L8 4.5Z"></path></svg
          >
        </button>
      </figure>
      <div class="lr-lab__copy">
        <SectionHeading title={home.lab.title} lead={home.lab.lead} />
        <ul class="lr-lab__facts" role="list">
          {
            home.lab.benefits.map((benefit) => (
              <li>
                <h3>{benefit}</h3>
              </li>
            ))
          }
        </ul>
        <LeadButton label={f.CTA!} source="lab" format="mobile-lab" />
      </div>
    </div>
  </div>
</section>
