---
import copy from "../../data/laptop-service.json";
import LeadForm from "../ui/LeadForm.astro";
import MapSlot from "../ui/MapSlot.astro";
import SocialLinks from "./SocialLinks.astro";
import workshops from "../../data/workshops.json";
import type { BrandPage } from "../../data/service-pages";
interface Props {
  brand?: Pick<BrandPage, "label">;
}
const { brand } = Astro.props;
interface QuizOption {
  value: string;
  label: string;
  detail: string;
  image?: string;
  plan?: {
    title: string;
    action: string;
    check: string;
    route: string;
    workshopOnly?: boolean;
  };
}
const questions: { name: string; title: string; options: QuizOption[] }[] = [
  {
    name: "device_category",
    title: "Какой у вас ноутбук?",
    options: [
      {
        value: "standard",
        label: "Обычный ноутбук",
        detail: "ASUS, Acer, Lenovo, HP и другие",
        image: "/media/brand-asus-hero.webp",
      },
      {
        value: "premium",
        label: "MacBook или премиальный ультрабук",
        detail: "Apple и модели с тонким корпусом",
        image: "/media/mac-hero-studio.webp",
      },
    ],
  },
  {
    name: "symptom",
    title: "Что случилось с ноутбуком?",
    options: [
      {
        value: "Залит водой, чаем или кофе",
        label: "Залит водой, чаем или кофе",
        detail:
          "Выберите этот вариант после пролива, даже если ноутбук работает",
        image: "/media/quiz-spill.webp",
        plan: {
          title: "После залития оставьте ноутбук выключенным",
          action:
            "Если это безопасно, отсоедините зарядку и выключите ноутбук. Не включайте его для проверки и не сушите феном.",
          check:
            "Даже под сухой клавиатурой может остаться жидкость. Мастер разберёт ноутбук, осмотрит плату и разъёмы и объяснит, достаточно ли очистки или повреждены детали.",
          route:
            "После залития ремонтируем только в мастерской. Привезите ноутбук или передайте курьеру. При передаче скажите, что пролилось и включали ли ноутбук после этого.",
          workshopOnly: true,
        },
      },
      {
        value: "Не включается",
        label: "Не реагирует на кнопку питания",
        detail: "Нет изображения, шума вентилятора и привычной индикации",
        image: "/media/symptom-no-power.webp",
        plan: {
          title: "Сначала стоит проверить питание",
          action:
            "Подготовьте ноутбук и его зарядное устройство. Если кабель повреждён или пахнет гарью, прекратите попытки включения.",
          check:
            "Мастер начнёт с блока питания и разъёма. Если питание доходит до ноутбука, проверит цепи на плате. Так можно выяснить, поможет ли замена зарядки.",
          route:
            "Возможность проверки по адресу уточним по модели. Если причину придётся искать на плате, понадобится мастерская.",
        },
      },
      {
        value: "Нет изображения",
        label: "Ноутбук работает, но экран тёмный",
        detail: "Слышен вентилятор или звук запуска, загораются индикаторы",
        image: "/media/symptom-screen.webp",
        plan: {
          title: "Тёмный экран ещё не повод покупать матрицу",
          action:
            "Вспомните, появлялся ли логотип при запуске и слышен ли обычный звук загрузки. Эти признаки помогут мастеру выбрать первую проверку.",
          check:
            "Мастер проверит вывод изображения на внешний экран, затем по результату осмотрит дисплей, подсветку и шлейф или продолжит диагностику запуска.",
          route:
            "Первичную проверку можно обсудить по адресу. Для диагностики платы предложим мастерскую.",
        },
      },
      {
        value: "Физическая поломка",
        label: "Треснул экран, сломалась петля или разъём",
        detail: "Видно повреждение корпуса, крышки или гнезда",
        image: "/media/failure-impact.webp",
        plan: {
          title: "Как не усугубить повреждение до осмотра",
          action:
            "Если петля вырывается из корпуса, оставьте крышку в текущем положении. В повреждённый разъём не вставляйте кабель.",
          check:
            "Мастер осмотрит крепления и соседние детали. Например, у тугой петли могут пострадать и посадочные места в крышке. После осмотра станет ясно, какие детали нужны.",
          route:
            "По модели и фотографии повреждения уточним, возможна ли замена по адресу. Если потребуется пайка разъёма, предложим мастерскую.",
        },
      },
      {
        value: "Восстановление данных",
        label: "Пропали файлы или не открывается диск",
        detail:
          "Случайное удаление, ошибка чтения или предложение отформатировать диск",
        image: "/media/quiz-lost-files.webp",
        plan: {
          title: "Сначала защитите файлы от перезаписи",
          action:
            "Прекратите работу с накопителем. Не устанавливайте программы восстановления, не форматируйте диск и не переустанавливайте систему.",
          check:
            "Мастер уточнит, удалены ли файлы или диск перестал читаться. Затем проверит состояние накопителя и оценит, можно ли снять копию для восстановления.",
          route:
            "Сообщите, какие папки важнее всего. При признаках неисправности самого накопителя понадобится диагностика в мастерской.",
        },
      },
      {
        value: "Программы и настройка",
        label: "Windows / macOS не загружается или выдаёт ошибку",
        detail: "Windows или macOS не загружается, ошибки, зависания, вирусы",
        image: "/media/failure-software.webp",
        plan: {
          title: "Сохраните текст ошибки до переустановки системы",
          action:
            "Сфотографируйте экран с ошибкой. Если файлы доступны, скопируйте важные документы на другой носитель перед восстановлением системы.",
          check:
            "Мастер уточнит, на каком этапе прерывается загрузка, и проверит накопитель. При исправном диске оценит, можно ли восстановить запуск с сохранением файлов.",
          route:
            "С программным сбоем можно начать на дому или в офисе. Если обнаружится неисправность накопителя, согласуем следующий шаг отдельно.",
        },
      },
      {
        value: "Чистка и перегрев",
        label: "Греется, шумит или гаснет",
        detail: "Греется, шумит или выключается под нагрузкой",
        image: "/media/failure-overheating.webp",
        plan: {
          title: "При перегреве прекратите нагрузку",
          action:
            "Закройте игру или тяжёлую программу и дайте ноутбуку остыть на твёрдой ровной поверхности. Если он уже выключился сам, не запускайте нагрузку повторно.",
          check:
            "Мастер проверит температуру, вентилятор и проход воздуха через радиатор. По результатам объяснит, достаточно ли чистки или нужен ремонт охлаждения.",
          route:
            "Для чистки уточним модель и возможность разборки на выезде. Если отключения сохранятся, потребуется дальнейшая диагностика.",
        },
      },
      {
        value: "Ускорение и апгрейд",
        label: "Ноутбук стал медленно работать",
        detail: "Долго включается, открывает программы или переключает вкладки",
        image: "/media/symptom-slow.webp",
        plan: {
          title: "Определите, в какой момент ноутбук замедляется",
          action:
            "Отметьте, что занимает больше времени — включение, запуск одной программы или работа с несколькими вкладками. Отложите покупку деталей до проверки модели.",
          check:
            "Мастер проверит состояние диска и загрузку памяти, а затем сверит доступные разъёмы. Так станет понятно, ускорит ли работу SSD или увеличение памяти.",
          route:
            "Если деталь совместима и конструкция допускает замену на месте, обсудим установку на дому. Перенос системы и файлов согласуем заранее.",
        },
      },
      {
        value: "Другая неисправность",
        label: "Другая проблема или не знаю причину",
        detail: "Сбой проявляется по-разному или случился впервые",
        image: "/media/quiz-unknown-fault.webp",
        plan: {
          title: "Для начала достаточно описать один сбой",
          action:
            "Запишите, что вы делали перед сбоем и что произошло на экране. Если ошибка повторится сама, сфотографируйте её.",
          check:
            "По описанию мастер выберет первую проверку. Например, если ноутбук успевает показать логотип, важно выяснить, на каком этапе останавливается загрузка.",
          route:
            "Если пока неясно, куда обращаться, выберите «Пока не решил». По симптомам и модели мастер подскажет, возможна ли проверка на месте.",
        },
      },
    ],
  },
  {
    name: "service_format",
    title: "Как вам удобнее передать ноутбук?",
    options: [
      {
        value: "mobile-lab",
        label: "К дому или работе",
        detail:
          "Выезд мобильной мастерской — уточним адрес и подходящие работы",
        image: "/media/mobile-lab-exterior.webp",
      },
      {
        value: "at-home",
        label: "Ремонт дома или в офисе",
        detail: "Мастер приедет по адресу — возможность работ согласуем",
        image: "/media/quiz-home-handoff.webp",
      },
      {
        value: "workshop",
        label: "Привезу в сервисный центр",
        detail: "Поможем выбрать мастерскую",
        image: "/media/quiz-workshop-handoff.webp",
      },
      {
        value: "courier",
        label: "Передам курьеру",
        detail: "Заберём и привезём курьером по акту",
        image: "/media/quiz-courier-handoff.webp",
      },
      {
        value: "consultation",
        label: "Пока не решил",
        detail: "Подберём удобный вариант",
        image: "/media/quiz-consultation.webp",
      },
    ],
  },
];
const pageQuestions = brand
  ? questions.filter((question) => question.name !== "device_category")
  : questions;
---

<section
  id="lr-quiz"
  class="lr-section lr-quiz"
  aria-labelledby="lr-quiz-title"
>
  <div class="lr-container lr-quiz__layout">
    <div class="lr-quiz__intro">
      <h2 id="lr-quiz-title">
        Пройдите онлайн-диагностику{brand ? ` ноутбука ${brand.label}` : ""}
      </h2>
      <p class="lr-lead">
        Ответьте на несколько вопросов о ноутбуке. Сразу увидите, что сделать
        сейчас, что проверит мастер и можно ли начать ремонт на дому.
      </p>
      <p class="lr-caption">
        Рекомендации доступны без телефона и адреса. Если понадобится ремонт,
        предварительную стоимость можно уточнить у мастера.
      </p>
    </div>
    <div class="lr-quiz__home" data-lr-quiz-home>
      <div class="lr-quiz__panel" data-lr-quiz>
        <noscript>
          <p class="lr-caption">
            Для подбора варианта ремонта позвоните:
            <a href="tel:+78123444444">{copy.contact.fields["Телефон"]}</a>.
          </p>
        </noscript>
        <div class="lr-quiz__toolbar" data-lr-quiz-toolbar hidden>
          <button
            type="button"
            class="lr-text-action lr-quiz__back"
            data-lr-quiz-prev
            hidden><span aria-hidden="true">←</span> Назад</button
          >
          <p class="lr-quiz__progress" data-lr-quiz-progress role="status"></p>
        </div>
        <progress
          class="lr-quiz__meter"
          data-lr-quiz-meter
          value="1"
          max={pageQuestions.length + 3}
          aria-hidden="true"
          hidden></progress>
        <div class="lr-quiz__result-offer" data-lr-quiz-plan hidden>
          <p class="lr-quiz__result-label">По вашим ответам</p>
          <h3 class="lr-quiz__question" tabindex="-1" data-lr-plan-title></h3>
          <dl class="lr-quiz__plan-details">
            <dt>Что сделать сейчас</dt><dd data-lr-plan-action></dd>
            <dt>Что проверит мастер</dt><dd data-lr-plan-check></dd>
            <dt>Где возможен ремонт</dt><dd data-lr-plan-route></dd>
          </dl>
        </div>
        <p id="lr-quiz-hint" class="lr-quiz__hint" data-lr-quiz-hint hidden>
          Выберите вариант — следующий шаг откроется автоматически.
        </p>
        <form
          data-lr-quiz-questions
          data-hop-lead-ignore
          aria-describedby="lr-quiz-hint"
          novalidate
        >
          {
            pageQuestions.map((question) => (
              <fieldset
                class="lr-quiz__step"
                data-lr-quiz-step
                data-lr-quiz-format-step={
                  question.name === "service_format" || undefined
                }
              >
                <legend class="lr-quiz__question" tabindex="-1">
                  {question.title}
                </legend>
                <div class="lr-quiz__options">
                  {question.options.map((option) => (
                    <label class="lr-quiz__option">
                      <input
                        type="radio"
                        name={question.name}
                        value={option.value}
                        data-plan-title={option.plan?.title}
                        data-plan-action={option.plan?.action}
                        data-plan-check={option.plan?.check}
                        data-plan-route={option.plan?.route}
                        data-workshop-only={
                          option.plan?.workshopOnly || undefined
                        }
                        required
                      />
                      <span class="lr-quiz__option-copy">
                        <strong>
                          {brand
                            ? option.label.replaceAll(
                                "Windows / macOS",
                                "Windows",
                              )
                            : option.label}
                        </strong>
                        {option.detail && (
                          <span class="lr-quiz__option-detail">
                            {brand
                              ? option.detail.replaceAll(
                                  "Windows или macOS",
                                  "Windows",
                                )
                              : option.detail}
                          </span>
                        )}
                      </span>
                      {option.image && (
                        <img
                          class="lr-quiz__option-image"
                          src={option.image}
                          alt=""
                          width="72"
                          height="72"
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                    </label>
                  ))}
                </div>
              </fieldset>
            ))
          }
        </form>
        <div
          class="lr-quiz__step lr-quiz__location"
          data-lr-quiz-step
          data-lr-quiz-location
        >
          <h3
            class="lr-quiz__question"
            tabindex="-1"
            data-lr-quiz-location-title
          >
            Уточните место ремонта
          </h3>
          <div
            class="lr-quiz__location-view"
            data-lr-quiz-location-view="workshops"
          >
            <p class="lr-caption">
              Выберите мастерскую, в которую вам удобно привезти ноутбук.
            </p>
            <MapSlot id="lr-quiz-map-workshops" type="workshops" />
            <div class="lr-form__field">
              <label for="lr-quiz-workshop">Мастерская</label>
              <select
                id="lr-quiz-workshop"
                data-lr-quiz-workshop
                aria-describedby="lr-quiz-error"
              >
                <option value="">Выберите мастерскую</option>
                {
                  workshops.workshops.map((workshop) => (
                    <option
                      value={workshop.id}
                      data-lr-workshop-address={workshop.address}
                    >
                      {workshop.city}, {workshop.address} — {workshop.metro}
                    </option>
                  ))
                }
              </select>
            </div>
          </div>
          <div
            class="lr-quiz__location-view"
            data-lr-quiz-location-view="address"
            hidden
          >
            <p class="lr-caption">
              Укажите населённый пункт, улицу и дом. Квартиру и код домофона
              можно сообщить при звонке.
            </p>
            <MapSlot id="lr-quiz-map-address" type="address" />
            <div class="lr-form__field">
              <label for="lr-quiz-address" data-lr-quiz-address-label
                >Куда приехать?</label
              >
              <input
                id="lr-quiz-address"
                data-lr-quiz-address
                type="text"
                autocomplete="street-address"
                placeholder="Населённый пункт, улица и дом"
                maxlength="240"
                aria-describedby="lr-quiz-error"
              />
            </div>
            <div class="lr-form__field" data-lr-quiz-place-field>
              <label for="lr-quiz-place">Где удобнее провести ремонт?</label>
              <select id="lr-quiz-place" data-lr-quiz-place>
                <option value="home">Дома</option>
                <option value="work">На работе</option>
                <option value="mobile-lab">В мастерской на колёсах</option>
                <option value="consultation">Уточнить при звонке</option>
              </select>
            </div>
          </div>
          <button type="button" class="lr-button" data-lr-quiz-location-confirm
            >Подтвердить адрес</button
          >
        </div>
        <div class="lr-quiz__step" data-lr-quiz-step data-lr-quiz-contact-step>
          <h3 class="lr-quiz__question" tabindex="-1">
            Как с вами удобнее связаться?
          </h3>
          <SocialLinks quizChoice />
        </div>
        <div class="lr-quiz__analysis" data-lr-quiz-analysis hidden>
          <div class="lr-quiz__analysis-visual" aria-hidden="true">
            <span class="lr-quiz__spinner"></span>
            <svg viewBox="0 0 48 48" width="48" height="48" fill="none">
              <path
                d="M14 5h15l8 8v30H11V5h3Zm15 0v9h8M18 23h12M18 30h7"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="m27 35 4 4 8-9"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3 tabindex="-1">Готовим ваш запрос на ремонт</h3>
          <p role="status">
            Неисправность и способ ремонта выбраны. Переносим ответы в заявку.
          </p>
          <p class="lr-quiz__analysis-note">
            Дальше — рекомендации и форма связи
          </p>
        </div>
        <div class="lr-quiz__step lr-quiz__result" data-lr-quiz-step>
          <h3 class="lr-quiz__question" tabindex="-1">
            Обсудить ремонт с мастером
          </h3>
          <p>
            Если нужен расчёт, оставьте контакт. Диагностика бесплатна даже при
            отказе. До ремонта согласуем полную стоимость и уточним условия
            скидки до 15%.
          </p>
          <LeadForm
            id="lr-quiz-form"
            source="quiz"
            serviceName={brand ? `Ремонт ноутбуков ${brand.label}` : undefined}
            submitLabel="Получить расчёт стоимости"
            contactChoice
          />
        </div>
        <p
          id="lr-quiz-error"
          class="lr-quiz__error"
          data-lr-quiz-error
          role="alert"
        >
        </p>
      </div>
    </div>
  </div>
</section>
