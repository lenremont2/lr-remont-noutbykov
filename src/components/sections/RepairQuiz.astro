---
import copy from "../../data/laptop-service.json";
import LeadForm from "../ui/LeadForm.astro";
import MapSlot from "../ui/MapSlot.astro";
import workshops from "../../data/workshops.json";
import type { BrandPage } from "../../data/service-pages";
interface Props {
  brand?: Pick<BrandPage, "label">;
}
const { brand } = Astro.props;
interface QuizOption {
  value: string;
  label: string;
  detail: string;
  image?: string;
}
const questions: { name: string; title: string; options: QuizOption[] }[] = [
  {
    name: "device_category",
    title: "Какой у вас ноутбук?",
    options: [
      {
        value: "standard",
        label: "Обычный ноутбук",
        detail: "ASUS, Acer, Lenovo, HP и другие",
        image: "/media/brand-asus-hero.webp",
      },
      {
        value: "premium",
        label: "MacBook или премиальный ультрабук",
        detail: "Apple и модели с тонким корпусом",
        image: "/media/mac-hero-studio.webp",
      },
    ],
  },
  {
    name: "symptom",
    title: "Что случилось с ноутбуком?",
    options: [
      {
        value: "Физическая поломка",
        label: "Сломался экран, разъём или не включается",
        detail: "Повреждены экран, клавиатура, петли или цепи питания",
        image: "/media/failure-impact.webp",
      },
      {
        value: "Залит водой, чаем или кофе",
        label: "Залит водой, чаем или кофе",
        detail: "Не включайте ноутбук и не сушите феном",
        image: "/media/quiz-spill.webp",
      },
      {
        value: "Восстановление данных",
        label: "Нужно восстановить данные и файлы",
        detail: "Фото, документы, базы 1С и рабочие проекты",
        image: "/media/quiz-lost-files.webp",
      },
      {
        value: "Программы и настройка",
        label: "Вирусы, программы или сбой Windows / macOS",
        detail: "Windows или macOS не загружается, ошибки, зависания, вирусы",
        image: "/media/failure-software.webp",
      },
      {
        value: "Чистка и перегрев",
        label: "Греется, шумит или гаснет",
        detail: "Греется, шумит или выключается под нагрузкой",
        image: "/media/failure-overheating.webp",
      },
      {
        value: "Ускорение и апгрейд",
        label: "Ускорить или обновить ноутбук",
        detail: "Установка SSD, увеличение памяти, перенос системы",
        image: "/media/symptom-slow.webp",
      },
      {
        value: "Другая неисправность",
        label: "Другая проблема или не знаю причину",
        detail: "Расскажете подробнее при звонке",
        image: "/media/quiz-unknown-fault.webp",
      },
    ],
  },
  {
    name: "service_format",
    title: "Как вам удобнее передать ноутбук?",
    options: [
      {
        value: "mobile-lab",
        label: "К дому или работе",
        detail:
          "Выезд мобильной мастерской — уточним адрес и подходящие работы",
        image: "/media/mobile-lab-exterior.webp",
      },
      {
        value: "at-home",
        label: "Ремонт дома или в офисе",
        detail: "Мастер приедет по адресу — возможность работ согласуем",
        image: "/media/quiz-home-handoff.webp",
      },
      {
        value: "workshop",
        label: "Привезу в сервисный центр",
        detail: "Поможем выбрать мастерскую",
        image: "/media/quiz-workshop-handoff.webp",
      },
      {
        value: "courier",
        label: "Передам курьеру",
        detail: "Заберём и привезём курьером по акту",
        image: "/media/quiz-courier-handoff.webp",
      },
      {
        value: "consultation",
        label: "Пока не решил",
        detail: "Подберём удобный вариант",
        image: "/media/quiz-consultation.webp",
      },
    ],
  },
];
const pageQuestions = brand
  ? questions.filter((question) => question.name !== "device_category")
  : questions;
---

<section
  id="lr-quiz"
  class="lr-section lr-quiz"
  aria-labelledby="lr-quiz-title"
>
  <div class="lr-container lr-quiz__layout">
    <div class="lr-quiz__intro">
      <p class="lr-eyebrow">Оценка ремонта онлайн</p>
      <h2 id="lr-quiz-title">
        Пройдите онлайн-диагностику{brand ? ` ноутбука ${brand.label}` : ""}
      </h2>
      <p class="lr-lead">
        Ответьте на несколько вопросов о поломке и удобном способе ремонта. В
        конце оставьте номер — мастер свяжется с Вами и назовёт предварительную
        стоимость.
      </p>
      <p class="lr-caption">
        Точную цену согласуем после бесплатной диагностики ноутбука, до начала
        работ.
      </p>
    </div>
    <div class="lr-quiz__home" data-lr-quiz-home>
      <div class="lr-quiz__panel" data-lr-quiz>
        <noscript>
          <p class="lr-caption">
            Для подбора варианта ремонта позвоните:
            <a href="tel:+78123444444">{copy.contact.fields["Телефон"]}</a>.
          </p>
        </noscript>
        <div class="lr-quiz__toolbar" data-lr-quiz-toolbar hidden>
          <button
            type="button"
            class="lr-text-action lr-quiz__back"
            data-lr-quiz-prev
            hidden><span aria-hidden="true">←</span> Назад</button
          >
          <p class="lr-quiz__progress" data-lr-quiz-progress role="status"></p>
        </div>
        <progress
          class="lr-quiz__meter"
          data-lr-quiz-meter
          value="1"
          max={pageQuestions.length + 2}
          aria-hidden="true"
          hidden></progress>
        <p id="lr-quiz-hint" class="lr-quiz__hint" data-lr-quiz-hint hidden>
          Выберите вариант — следующий шаг откроется автоматически.
        </p>
        <form
          data-lr-quiz-questions
          data-hop-lead-ignore
          aria-describedby="lr-quiz-hint"
          novalidate
        >
          {
            pageQuestions.map((question) => (
              <fieldset class="lr-quiz__step" data-lr-quiz-step>
                <legend class="lr-quiz__question" tabindex="-1">
                  {question.title}
                </legend>
                <div class="lr-quiz__options">
                  {question.options.map((option) => (
                    <label class="lr-quiz__option">
                      <input
                        type="radio"
                        name={question.name}
                        value={option.value}
                        required
                      />
                      <span class="lr-quiz__option-copy">
                        <strong>
                          {brand
                            ? option.label.replaceAll(
                                "Windows / macOS",
                                "Windows",
                              )
                            : option.label}
                        </strong>
                        {option.detail && (
                          <span class="lr-quiz__option-detail">
                            {brand
                              ? option.detail.replaceAll(
                                  "Windows или macOS",
                                  "Windows",
                                )
                              : option.detail}
                          </span>
                        )}
                      </span>
                      {option.image && (
                        <img
                          class="lr-quiz__option-image"
                          src={option.image}
                          alt=""
                          width="72"
                          height="72"
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                    </label>
                  ))}
                </div>
              </fieldset>
            ))
          }
        </form>
        <div
          class="lr-quiz__step lr-quiz__location"
          data-lr-quiz-step
          data-lr-quiz-location
        >
          <h3
            class="lr-quiz__question"
            tabindex="-1"
            data-lr-quiz-location-title
          >
            Уточните место ремонта
          </h3>
          <div
            class="lr-quiz__location-view"
            data-lr-quiz-location-view="workshops"
          >
            <p class="lr-caption">
              Выберите мастерскую, в которую вам удобно привезти ноутбук.
            </p>
            <MapSlot id="lr-quiz-map-workshops" type="workshops" />
            <div class="lr-form__field">
              <label for="lr-quiz-workshop">Мастерская</label>
              <select
                id="lr-quiz-workshop"
                data-lr-quiz-workshop
                aria-describedby="lr-quiz-error"
              >
                <option value="">Выберите мастерскую</option>
                {
                  workshops.workshops.map((workshop) => (
                    <option
                      value={workshop.id}
                      data-lr-workshop-address={workshop.address}
                    >
                      {workshop.city}, {workshop.address} — {workshop.metro}
                    </option>
                  ))
                }
              </select>
            </div>
          </div>
          <div
            class="lr-quiz__location-view"
            data-lr-quiz-location-view="address"
            hidden
          >
            <p class="lr-caption">
              Укажите населённый пункт, улицу и дом. Квартиру и код домофона
              можно сообщить при звонке.
            </p>
            <MapSlot id="lr-quiz-map-address" type="address" />
            <div class="lr-form__field">
              <label for="lr-quiz-address" data-lr-quiz-address-label
                >Куда приехать?</label
              >
              <input
                id="lr-quiz-address"
                data-lr-quiz-address
                type="text"
                autocomplete="street-address"
                placeholder="Населённый пункт, улица и дом"
                maxlength="240"
                aria-describedby="lr-quiz-error"
              />
            </div>
            <div class="lr-form__field" data-lr-quiz-place-field>
              <label for="lr-quiz-place">Где удобнее провести ремонт?</label>
              <select id="lr-quiz-place" data-lr-quiz-place>
                <option value="home">Дома</option>
                <option value="work">На работе</option>
                <option value="mobile-lab">В мастерской на колёсах</option>
                <option value="consultation">Уточнить при звонке</option>
              </select>
            </div>
          </div>
          <button type="button" class="lr-button" data-lr-quiz-location-confirm
            >Подтвердить адрес</button
          >
        </div>
        <div class="lr-quiz__analysis" data-lr-quiz-analysis hidden>
          <div class="lr-quiz__analysis-visual" aria-hidden="true">
            <span class="lr-quiz__spinner"></span>
            <svg viewBox="0 0 48 48" width="48" height="48" fill="none">
              <path
                d="M14 5h15l8 8v30H11V5h3Zm15 0v9h8M18 23h12M18 30h7"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="m27 35 4 4 8-9"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3 tabindex="-1">Готовим ваш запрос на ремонт</h3>
          <p role="status">
            Неисправность и способ ремонта выбраны. Переносим ответы в заявку.
          </p>
          <p class="lr-quiz__analysis-note">Следующий шаг — номер для связи</p>
        </div>
        <div class="lr-quiz__step lr-quiz__result" data-lr-quiz-step>
          <div class="lr-quiz__result-offer">
            <p class="lr-quiz__result-label">
              Остался один шаг · скидка до 15%
            </p>
            <h3 class="lr-quiz__question" tabindex="-1">
              Узнайте стоимость ремонта
            </h3>
            <p>
              Оставьте телефон — обсудим стоимость ремонта и условия скидки.
            </p>
            <div class="lr-quiz__result-facts">
              <p>
                <strong>0 ₽</strong> диагностика, даже при отказе
              </p>
              <p>
                Полную стоимость согласуем <strong>до ремонта</strong>
              </p>
            </div>
          </div>
          <details class="lr-quiz__answers">
            <summary>Ваши ответы сохранены <span>Проверить</span></summary>
            <dl class="lr-quiz__summary">
              <div>
                <dt>Ноутбук</dt>
                <dd data-lr-quiz-answer="device_category">
                  {brand?.label || "—"}
                </dd>
              </div>
              <div>
                <dt>Неисправность</dt>
                <dd data-lr-quiz-answer="symptom">—</dd>
              </div>
              <div>
                <dt>Способ ремонта</dt>
                <dd data-lr-quiz-answer="service_format">—</dd>
              </div>
              <div data-lr-quiz-location-summary hidden>
                <dt data-lr-quiz-location-label>Адрес</dt>
                <dd data-lr-quiz-location-value></dd>
              </div>
            </dl>
          </details>
          <LeadForm
            id="lr-quiz-form"
            source="quiz"
            serviceName={brand ? `Ремонт ноутбуков ${brand.label}` : undefined}
            submitLabel="Получить расчёт стоимости"
            requestTiming
          />
        </div>
        <p
          id="lr-quiz-error"
          class="lr-quiz__error"
          data-lr-quiz-error
          role="alert"
        >
        </p>
      </div>
    </div>
  </div>
</section>
