---
import copy from "../../data/laptop-service.json";
import LeadButton from "../ui/LeadButton.astro";
import QuickContacts from "./QuickContacts.astro";
import type { BrandPage } from "../../data/service-pages";
interface Props {
  imageWidth?: number;
  imageHeight?: number;
  brand?: Pick<BrandPage, "h1" | "lead" | "label" | "heroImage">;
}
const { brand, imageWidth = 768, imageHeight = 1024 } = Astro.props;
const Heading = brand ? "h1" : "h2";
const c = copy.hero.fields;
const [repairLabel, repairDuration] = c["Срок ремонта"].split(" всего за ");
---

<section
  id="lr-hero"
  class:list={[
    "lr-hero lr-section",
    { "lr-hero--home": !brand, "lr-hero--brand": !!brand },
  ]}
  aria-labelledby="lr-hero-title"
>
  <div class="lr-container lr-hero__grid">
    <figure class="lr-hero__media">
      {
        brand ? (
          <img
            class="lr-hero__photo"
            src={brand.heroImage}
            alt={`Ноутбук ${brand.label} на рабочем столе для диагностики`}
            width={imageWidth}
            height={imageHeight}
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <video
            class="lr-hero__video"
            loop
            muted
            data-lr-hero-video
            playsinline
            preload="none"
            width="480"
            height="640"
            poster="/media/mobile-lab-exterior.webp"
            aria-label="Мобильная мастерская Ленремонта — ремонт ноутбуков"
          >
            <source src="/media/notebook-auto.mp4" type="video/mp4" />
            Мобильная мастерская Ленремонта — ремонт ноутбуков.
          </video>
        )
      }
      {
        brand && (
          <figcaption class="lr-hero__brand-time">
            <span>{repairLabel} всего за</span>
            <strong>{repairDuration}</strong>
          </figcaption>
        )
      }
    </figure>
    <div class="lr-hero__copy">
      <p class="lr-eyebrow">
        <span class="lr-status-dot" aria-hidden="true"> </span>{
          c["Надзаголовок"]
        }
      </p>
      <Heading class="lr-hero__title" id="lr-hero-title">
        {
          brand ? (
            brand.h1
          ) : (
            <>
              <span class="lr-hero__title-intro">{c["H2"]}</span>
              <span class="lr-hero__title-message">
                {repairLabel} всего за{" "}
                <span class="lr-hero__title-accent">{repairDuration}</span>
              </span>
            </>
          )
        }
      </Heading>
      <p class="lr-lead lr-hero__lead">{brand?.lead ?? c["Лид"]}</p>
      <div class="lr-actions" data-lr-hero-cta>
        <LeadButton
          label={c["Основной CTA"]}
          source={brand ? `brand:${brand.label}` : "hero"}
        />
        <a
          class="lr-text-action"
          href={brand ? "#lr-formats" : "#lr-map-workshops"}
          >{c["Второй CTA"]}<span aria-hidden="true">↗</span>
        </a>
      </div>
      <ul class="lr-hero__facts" aria-label="Преимущества ремонта в Ленремонте">
        {
          copy.hero.bullets.map((fact) => (
            <li>
              <span class="lr-fact-mark" aria-hidden="true" />
              <div>
                <h3>{fact.title}</h3>
                {fact.text ? <p>{fact.text}</p> : null}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
    <QuickContacts />
  </div>
</section>
