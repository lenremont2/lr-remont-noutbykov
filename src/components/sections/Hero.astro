---
import copy from "../../data/laptop-service.json";
import home from "../../data/home-copy.json";
import LeadButton from "../ui/LeadButton.astro";
import QuickContacts from "./QuickContacts.astro";
import type { BrandPage } from "../../data/service-pages";
interface Props {
  variant?: "default" | "home";
  imageWidth?: number;
  imageHeight?: number;
  brand?: Pick<
    BrandPage,
    "h1" | "lead" | "label" | "heroImage" | "repairTimeNote"
  >;
}
const {
  brand,
  variant = "default",
  imageWidth = 768,
  imageHeight = 1024,
} = Astro.props;
const usesRepairIllustration =
  brand?.heroImage === "/media/laptop-engineer-hero.webp";
const c = copy.hero.fields;
const [repairLabel, repairDuration] = c["Срок ремонта"].split(" всего за ");
const facts = [
  "Стоимость согласуем до ремонта",
  "Оплата после вашей проверки",
  "Гарантия на ремонт — 1 год",
];
const [homeLead, homeProtection] = home.hero.lead.split(/(?=Называем)/);
---

{
  !brand || variant === "home" ? (
    <section
      id="lr-hero"
      class={`lr-hero lr-section lr-hero--reference ${brand ? "lr-hero--brand-reference" : "lr-hero--home"}`}
      aria-labelledby="lr-hero-title"
      data-sc-act="flow"
    >
      <div class="lr-hero__reference">
        <div class="lr-hero__stage">
          {brand ? (
            <div class="lr-hero__film">
              <img
                class="lr-hero__stage-photo"
                src={brand.heroImage}
                alt={
                  usesRepairIllustration
                    ? "Иллюстрация диагностики ноутбука инженером"
                    : `Ноутбук ${brand.label} на рабочем столе для диагностики`
                }
                width={usesRepairIllustration ? 580 : imageWidth}
                height={usesRepairIllustration ? 384 : imageHeight}
                fetchpriority="high"
                decoding="async"
              />
            </div>
          ) : (
            <>
              <div class="lr-hero__film">
                <video
                  class="lr-hero__stage-video"
                  autoplay
                  loop
                  muted
                  data-lr-hero-video
                  playsinline
                  preload="auto"
                  width="480"
                  height="640"
                  poster="/media/notebook-auto-poster.webp"
                  aria-label="Мобильная мастерская Ленремонта — ремонт ноутбуков"
                >
                  <source
                    src="/media/notebook-auto-hero.webm"
                    type="video/webm"
                  />
                  Мобильная мастерская Ленремонта — ремонт ноутбуков.
                </video>
                <img
                  class="lr-hero__video-preview"
                  data-lr-hero-preview
                  src="/media/notebook-auto-poster.webp"
                  alt=""
                  width="480"
                  height="640"
                  fetchpriority="high"
                  decoding="async"
                />
                <button
                  class="lr-hero__video-play"
                  type="button"
                  data-lr-hero-play
                  hidden
                  aria-label="Запустить видео мобильной мастерской"
                >
                  ▶ Смотреть видео
                </button>
                <p class="lr-hero__scene-note">
                  <span class="lr-hero__scene-mark" aria-hidden="true">
                    ✓
                  </span>
                  <span>
                    <strong>Сначала согласуем.</strong>Затем ремонтируем.
                  </span>
                </p>
              </div>
            </>
          )}
        </div>
        <div class="lr-hero__reference-copy">
          <h1 class="lr-hero__seo" id="lr-hero-title">
            {brand?.h1 ??
              "Ремонт ноутбуков на дому или в сервисном центре в Санкт-Петербурге и ЛО"}
          </h1>
          <h2 class="lr-hero__offer">
            {brand ? `Ремонт ноутбуков ${brand.label}` : home.hero.title} —
            диагностика <span class="lr-hero__highlight">бесплатно (0 ₽)</span>{" "}
            даже при
            {brand ? "отказе от ремонта" : "отказе"}
          </h2>
          <p class="lr-hero__reference-lead">
            {brand ? (
              brand.lead
            ) : (
              <>
                {homeLead}
                <strong>{homeProtection}</strong>
              </>
            )}
          </p>
          <ul class="lr-hero__benefits" aria-label="Условия ремонта">
            {home.hero.bullets.map((fact) => (
              <li class="lr-hero__benefit">
                <div class="lr-hero__benefit-top">
                  <span class="lr-hero__benefit-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path
                        d="m4 12 5.5 5.5L21 6"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                  <strong>{fact.title}</strong>
                </div>
                <span class="lr-hero__benefit-description">{fact.text}</span>
              </li>
            ))}
          </ul>
          <div class="lr-hero__cta" data-lr-hero-cta>
            <a
              class="lr-button lr-hero__primary"
              href="#lr-quiz"
              data-lr-quiz-open
              aria-controls="lr-quiz-modal"
              aria-haspopup="dialog"
            >
              Узнать стоимость
            </a>
            <LeadButton
              label="Оставить заявку"
              source={brand ? `brand:${brand.label}` : "hero-request"}
              class="lr-hero__secondary"
            />
          </div>
        </div>
        <div class="lr-hero__contacts">
          <QuickContacts messengerText={home.hero.messengerText} />
        </div>
      </div>
    </section>
  ) : (
    <section
      id="lr-hero"
      class="lr-hero lr-section lr-hero--brand"
      aria-labelledby="lr-hero-title"
    >
      <div class="lr-container lr-hero__grid">
        <div class="lr-hero__copy">
          <h1 class="lr-hero__title" id="lr-hero-title">
            {brand.h1}
          </h1>
          <p class="lr-lead lr-hero__lead">{brand.lead}</p>
          <p class="lr-caption">
            Диагностика — бесплатно, даже при отказе от ремонта.
          </p>
          <div class="lr-actions" data-lr-hero-cta>
            <LeadButton
              label={c["Основной CTA"]}
              source={`brand:${brand.label}`}
            />
            <a class="lr-text-action" href="#lr-formats">
              {c["Второй CTA"]}
            </a>
          </div>
        </div>
        <figure class="lr-hero__media">
          <img
            class="lr-hero__photo"
            src={brand.heroImage}
            alt={
              usesRepairIllustration
                ? "Иллюстрация диагностики ноутбука инженером"
                : `Ноутбук ${brand.label} на рабочем столе для диагностики`
            }
            width={usesRepairIllustration ? 580 : imageWidth}
            height={usesRepairIllustration ? 384 : imageHeight}
            fetchpriority="high"
            decoding="async"
          />
          <figcaption class="lr-hero__brand-time">
            {brand.repairTimeNote ? (
              <span>{brand.repairTimeNote}</span>
            ) : (
              <>
                <span>{repairLabel} всего за</span>
                <strong>{repairDuration}</strong>
              </>
            )}
          </figcaption>
        </figure>
        <ul
          class="lr-hero__facts"
          aria-label="Преимущества ремонта в Ленремонте"
        >
          {facts.map((fact) => (
            <li>
              <div>
                <h3>{fact}</h3>
              </div>
            </li>
          ))}
        </ul>
        <QuickContacts />
      </div>
    </section>
  )
}
