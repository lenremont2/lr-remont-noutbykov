---
import copy from "../../data/laptop-service.json";
import LeadButton from "../ui/LeadButton.astro";
import QuickContacts from "./QuickContacts.astro";
import type { BrandPage } from "../../data/service-pages";
interface Props {
  imageWidth?: number;
  imageHeight?: number;
  brand?: Pick<
    BrandPage,
    "h1" | "lead" | "label" | "heroImage" | "repairTimeNote"
  >;
}
const { brand, imageWidth = 768, imageHeight = 1024 } = Astro.props;
const usesRepairIllustration =
  brand?.heroImage === "/media/laptop-engineer-hero.webp";
const c = copy.hero.fields;
const [repairLabel, repairDuration] = c["Срок ремонта"].split(" всего за ");
const facts = [
  "Диагностика ноутбука — 0 ₽ в мастерской",
  "Восстанавливаем платы ноутбуков",
  "Гарантия на ремонт — 1 год",
  "Проверяете ноутбук до оплаты",
];
---

{
  !brand ? (
    <section
      id="lr-hero"
      class="lr-hero lr-section lr-hero--home"
      aria-labelledby="lr-hero-title"
      data-lr-depth-scene
      data-sc-act="flow"
    >
      <div class="lr-container lr-hero__grid">
        <nav class="lr-home-nav" aria-label="Разделы страницы">
          <span class="lr-home-nav__brand">
            <img
              src="/media/lenremont-logo-patch.png"
              width="228"
              height="39"
              alt="Ленремонт"
            />
            <span>Ремонт ноутбуков</span>
          </span>
          <div class="lr-home-nav__links">
            <a href="#lr-formats">Способы ремонта</a>
            <a href="#lr-process">Как всё проходит</a>
            <a href="#lr-prices">Цены</a>
            <a href="#lr-guarantee">Гарантия</a>
          </div>
        </nav>
        <figure class="lr-hero__media">
          <div class="lr-hero__backplane" aria-hidden="true" />
          <div class="lr-hero__film">
            <video
              class="lr-hero__video"
              autoplay
              loop
              muted
              data-lr-hero-video
              playsinline
              preload="metadata"
              width="480"
              height="640"
              poster="/media/mobile-lab-exterior.webp"
              aria-label="Мобильная мастерская Ленремонта — ремонт ноутбуков"
            >
              <source src="/media/notebook-auto.mp4" type="video/mp4" />
              Мобильная мастерская Ленремонта — ремонт ноутбуков.
            </video>
          </div>
          <figcaption class="lr-hero__scene-note">
            <span class="lr-hero__scene-mark" aria-hidden="true">
              ✓
            </span>
            <span>
              <strong>Сначала согласуем.</strong>Затем ремонтируем.
            </span>
          </figcaption>
        </figure>
        <div class="lr-hero__copy">
          <h1 class="lr-hero__title" id="lr-hero-title">
            <span class="lr-hero__title-message">
              Ремонт ноутбуков на дому или в сервисном центре
            </span>
            <span class="lr-hero__title-location">
              в Санкт-Петербурге и Ленинградской области
            </span>
          </h1>
          <p class="lr-lead lr-hero__lead">
            <strong class="lr-hero__diagnostics">
              Обычная диагностика в мастерской — бесплатно, даже при отказе от
              ремонта.
            </strong>
            Стоимость согласуем до начала работ.
          </p>
          <div class="lr-actions" data-lr-hero-cta>
            <a
              class="lr-button"
              href="#lr-quiz"
              data-lr-quiz-open
              aria-controls="lr-quiz-modal"
              aria-haspopup="dialog"
            >
              {c["Основной CTA"]}
            </a>
            <LeadButton label="Оставить заявку" source="hero-request" text />
          </div>
          <a class="lr-hero__route-link" href="#lr-formats">
            В мастерской, у вас дома или с доставкой
          </a>
          <ul
            class="lr-hero__facts"
            aria-label="Преимущества ремонта в Ленремонте"
          >
            {facts.map((fact) => (
              <li>
                <span class="lr-fact-mark" aria-hidden="true" />
                <h3>{fact}</h3>
              </li>
            ))}
          </ul>
        </div>
        <QuickContacts />
      </div>
    </section>
  ) : (
    <section
      id="lr-hero"
      class="lr-hero lr-section lr-hero--brand"
      aria-labelledby="lr-hero-title"
    >
      <div class="lr-container lr-hero__grid">
        <div class="lr-hero__copy">
          <h1 class="lr-hero__title" id="lr-hero-title">
            {brand.h1}
          </h1>
          <p class="lr-lead lr-hero__lead">{brand.lead}</p>
          <p class="lr-caption">
            Обычная диагностика в мастерской — бесплатно, даже при отказе от
            ремонта.
          </p>
          <div class="lr-actions" data-lr-hero-cta>
            <LeadButton
              label={c["Основной CTA"]}
              source={`brand:${brand.label}`}
            />
            <a class="lr-text-action" href="#lr-formats">
              {c["Второй CTA"]}
            </a>
          </div>
        </div>
        <figure class="lr-hero__media">
          <img
            class="lr-hero__photo"
            src={brand.heroImage}
            alt={
              usesRepairIllustration
                ? "Иллюстрация диагностики ноутбука инженером"
                : `Ноутбук ${brand.label} на рабочем столе для диагностики`
            }
            width={usesRepairIllustration ? 580 : imageWidth}
            height={usesRepairIllustration ? 384 : imageHeight}
            fetchpriority="high"
            decoding="async"
          />
          <figcaption class="lr-hero__brand-time">
            {brand.repairTimeNote ? (
              <span>{brand.repairTimeNote}</span>
            ) : (
              <>
                <span>{repairLabel} всего за</span>
                <strong>{repairDuration}</strong>
              </>
            )}
          </figcaption>
        </figure>
        <ul
          class="lr-hero__facts"
          aria-label="Преимущества ремонта в Ленремонте"
        >
          {facts.map((fact) => (
            <li>
              <div>
                <h3>{fact}</h3>
              </div>
            </li>
          ))}
        </ul>
        <QuickContacts />
      </div>
    </section>
  )
}
