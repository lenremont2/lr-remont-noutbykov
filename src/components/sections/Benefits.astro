---
import copy from "../../data/laptop-service.json";
import SectionHeading from "../ui/SectionHeading.astro";
import LeadButton from "../ui/LeadButton.astro";
const c = copy.benefits.fields;
---

<section id="lr-benefits" class="lr-section lr-benefits">
  <div class="lr-container">
    <SectionHeading title={c.H2} />
    <div class="lr-benefits__grid">
      {
        copy.benefits.items.map((benefit) => (
          <article class="lr-benefit">
            <h3>{benefit.title}</h3>
            <p class="lr-benefit__detail">{benefit.text}</p>
          </article>
        ))
      }
    </div>
    <div class="lr-benefits__footer">
      <p>Назовите модель — подскажем стоимость ремонта.</p>
      <LeadButton label={c.CTA} source="benefits" text />
    </div>
  </div>
</section>
