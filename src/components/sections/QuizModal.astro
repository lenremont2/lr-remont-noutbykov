<dialog
  id="lr-quiz-modal"
  class="lr-quiz-modal"
  data-lr-quiz-modal
  aria-labelledby="lr-quiz-modal-title"
  aria-modal="true"
>
  <div class="lr-quiz-modal__surface">
    <button
      class="lr-quiz-modal__close"
      type="button"
      data-lr-quiz-close
      aria-label="Закрыть подбор варианта ремонта"
      ><span aria-hidden="true">×</span></button
    >
    <h2 id="lr-quiz-modal-title">Поможем выбрать удобный способ ремонта</h2>
    <div data-lr-quiz-slot></div>
  </div>
</dialog>
