---
import copy from "../../data/laptop-service.json";
import reviews from "../../data/reviews.json";
import homePhotos from "../../data/review-illustrations.json";
import ReviewCard from "../ui/ReviewCard.astro";
import SectionHeading from "../ui/SectionHeading.astro";
const c = copy.reviews.fields;
interface Props {
  scrollScene?: boolean;
  title?: string;
  homeVariant?: boolean;
}
const { scrollScene = false, title = c.H2, homeVariant = false } = Astro.props;
interface Aggregator {
  name: string;
  url: string;
  rating: number;
  ratingCount: number;
}
const { aggregators = [] } = reviews as typeof reviews & {
  aggregators?: Aggregator[];
};
const ratingValue = (rating: number) =>
  rating.toLocaleString("ru-RU", {
    minimumFractionDigits: 1,
    maximumFractionDigits: 1,
  });
const countLabel = (count: number) => {
  const last = count % 10;
  const lastTwo = count % 100;
  if (lastTwo >= 11 && lastTwo <= 14) return "оценок";
  return last === 1 ? "оценка" : last >= 2 && last <= 4 ? "оценки" : "оценок";
};
const documents = [
  {
    image: "/media/lenremont-nagrady_blagodarnosti1-1.jpg",
    title: "Диплом «Gazelle Бизнеса 2016»",
  },
  {
    image: "/media/lenremont-nagrady_blagodarnosti2-1.jpg",
    title: "Благодарственное письмо школы-интерната № 6",
  },
  {
    image: "/media/lenremont-svidetelstvo3-1.jpg",
    title: "Свидетельство на товарный знак № 430931",
  },
  {
    image: "/media/lenremont-svidetelstvo4-1.jpg",
    title: "Свидетельство на товарный знак № 442165",
  },
];
---

<section
  id="lr-reviews"
  class:list={[
    "lr-section lr-section--compact",
    { "lr-reviews--wide-photos": homeVariant },
  ]}
  data-lr-review-slider
  data-sc-act={scrollScene ? "flow" : undefined}
>
  <div class="lr-container lr-reviews">
    <div class="lr-reviews__header">
      <SectionHeading title={title} />
    </div>
    {
      aggregators.length > 0 && (
        <ul class="lr-reviews__ratings" aria-label="Рейтинги на площадках">
          {aggregators.map((item) => (
            <li>
              <div class="lr-reviews__rating-card">
                <strong class="lr-reviews__rating-value">
                  <span class="lr-visually-hidden">Рейтинг </span>
                  {ratingValue(item.rating)}
                  <span class="lr-visually-hidden"> из 5</span>
                </strong>
                <span class="lr-reviews__rating-stars" aria-hidden="true">
                  {Array.from({ length: 5 }, () => (
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L3 9.6l6.2-.9L12 3Z" />
                    </svg>
                  ))}
                </span>
                <span class="lr-reviews__rating-source">
                  <span>{item.name}</span>
                  <span aria-hidden="true"> · </span>
                  <span class="lr-reviews__rating-count">
                    {item.ratingCount.toLocaleString("ru-RU")}{" "}
                    {countLabel(item.ratingCount)}
                  </span>
                </span>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div>
  {
    !homeVariant && (
      <div class="lr-container lr-reviews__awards">
        <h3>Признание компании</h3>
        <div class="lr-reviews__award">
          <>
            <strong>2026</strong>
            <p>
              Рейтинг брендов
              <>
                <br />
                <span>Деловой Петербург</span>
              </>
            </p>
          </>
        </div>
      </div>
    )
  }
  <div class="lr-reviews__stage">
    <div
      class="lr-container lr-reviews__frame"
      data-lr-review-frame
      aria-hidden="true"
    >
    </div>
    <div
      id="lr-review-track"
      class="lr-reviews__track"
      data-lr-review-track
      role="region"
      aria-label="Отзывы клиентов Ленремонта, листайте влево и вправо"
      aria-roledescription="карусель"
      tabindex="0"
    >
      {
        reviews.items
          .filter((review) => !homeVariant || review.name !== "Петр Перцев")
          .map((review) => (
            <ReviewCard
              hideYandexLinks={homeVariant}
              review={
                homeVariant &&
                homePhotos[review.name as keyof typeof homePhotos]
                  ? {
                      ...review,
                      photos: [
                        homePhotos[review.name as keyof typeof homePhotos],
                      ],
                    }
                  : review
              }
              source={
                reviews.sources[review.source as keyof typeof reviews.sources]
              }
            />
          ))
      }
    </div>
  </div>
  {
    homeVariant && (
      <div class="lr-container lr-reviews__documents">
        <div class="lr-reviews__subhead">
          <h3>Официальные дипломы и сертификаты</h3>
        </div>
        <ul
          class="lr-documents"
          tabindex="0"
          aria-label="Дипломы и сертификаты"
        >
          {documents.map((document) => (
            <li class="lr-document">
              <a
                class="lr-document__preview"
                href={document.image}
                data-lr-photo-open
                aria-label={`Открыть: ${document.title}`}
              >
                <img
                  src={document.image}
                  alt={document.title}
                  width="924"
                  height="1250"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="lr-document__copy">
                <h4>{document.title}</h4>
              </div>
            </li>
          ))}
        </ul>
      </div>
    )
  }
  <dialog
    class:list={["lr-photo-dialog", { "lr-photo-dialog--wide": homeVariant }]}
    data-lr-review-photo
    aria-label={homeVariant ? "Просмотр фотографии" : "Фотография из отзыва"}
  >
    <button
      type="button"
      class="lr-photo-dialog__close"
      data-lr-photo-close
      aria-label="Закрыть фотографию">×</button
    >
    <img data-lr-photo-image alt="" />
    <p data-lr-photo-caption></p>
  </dialog>
</section>
