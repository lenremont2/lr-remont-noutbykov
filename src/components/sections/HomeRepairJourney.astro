---
interface Props {
  title?: string;
  items?: { title: string; text: string }[];
}
const { title = "Как проходит ремонт ноутбука", items } = Astro.props;
const steps = [
  {
    title: "Обращение",
    text: "Вы описываете поломку. Вместе решаем, удобнее вызвать мастера или привезти ноутбук в мастерскую",
    icon: "contact",
  },
  {
    title: "Диагностика",
    text: "Мастер проводит бесплатную диагностику ноутбука, объясняет причину поломки и называет полную стоимость работ и деталей",
    icon: "diagnosis",
  },
  {
    title: "Вы согласуете цену",
    text: "Мастер начинает ремонт только с Вашего согласия. Если цена не подходит, Вы можете отказаться. Диагностика останется бесплатной",
    icon: "approval",
  },
  {
    title: "Проверка и оплата",
    text: "Вы проверяете ноутбук вместе с мастером, затем оплачиваете ремонт и получаете чек и гарантийный талон на 1 год",
    icon: "handover",
  },
].map((step, index) => ({ ...step, ...items?.[index] }));
---

<section
  id="lr-process"
  class="lr-section lr-repair-journey"
  aria-labelledby="lr-journey-title"
>
  <div class="lr-container">
    <div class="lr-repair-journey__heading">
      <h2 id="lr-journey-title">{title}</h2>
    </div>
    <ol class="lr-repair-journey__steps" role="list">
      {
        steps.map((step, index) => (
          <li class="lr-repair-journey__step">
            <span
              class:list={[
                "lr-repair-journey__number",
                {
                  "lr-repair-journey__number--approval":
                    step.icon === "approval",
                },
              ]}
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, "0")}
            </span>
            <div class="lr-repair-journey__copy">
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
            <img
              class="lr-repair-journey__icon"
              src={`/media/journey-icon-${step.icon}.svg`}
              alt=""
              width="72"
              height="72"
              loading="lazy"
              decoding="async"
            />
          </li>
        ))
      }
    </ol>
  </div>
</section>
