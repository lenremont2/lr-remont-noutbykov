---
import copy from "../../data/laptop-service.json";

interface Props {
  title?: string;
  items?: { title: string; text: string }[];
}
const { title = "Как проходит ремонт", items } = Astro.props;
const steps = [
  {
    title: copy.process.items[0].title,
    text: "Опишите симптомы по телефону или в мессенджере. Назовём предварительную стоимость и подберём один из четырёх форматов: на дому, в фургоне, в сервисном центре или с курьером.",
    image: "/media/journey-process-reception-1280.webp",
    caption: "Мастер принимает ноутбук и обсуждает неисправность с клиентом",
  },
  {
    title: copy.process.items[1].title,
    text: "Мастер бесплатно проверит ноутбук на дому, в мобильной мастерской или сервисном центре. Диагностика — 0 ₽, даже если после расчёта сметы вы откажетесь от ремонта.",
    image: "/media/journey-process-diagnostics-1280.webp",
    caption: "Мастер проверяет плату ноутбука мультиметром",
  },
  {
    title: copy.process.items[2].title,
    text: "Назовём полную фиксированную сумму за работу и детали. До вашего согласия ремонт не начинаем: никаких скрытых доплат за драйверы или сборку-разборку.",
    image: "/media/journey-process-estimate-1280.webp",
    caption: "Мастер и клиент согласуют смету до начала ремонта",
  },
  {
    title: copy.process.items[3].title,
    text: "Включим ноутбук и проверим его под нагрузкой вместе с вами до оплаты. Вы получите чек, договор, гарантийный талон на 1 год и все заменённые детали.",
    image: "/media/journey-process-handover-1280.webp",
    caption: "Клиент проверяет отремонтированный ноутбук вместе с мастером",
  },
].map((step, index) => ({ ...step, ...items?.[index] }));
---

<section
  id="lr-process"
  class="lr-section lr-repair-journey"
  aria-labelledby="lr-journey-title"
  data-lr-repair-journey
  data-sc-act="flow"
>
  <div class="lr-container">
    <div class="lr-repair-journey__heading">
      <h2 id="lr-journey-title">{title}</h2>
    </div>
    <div class="lr-repair-journey__layout">
      <ol class="lr-repair-journey__steps" role="list">
        {
          steps.map((step) => (
            <li class="lr-repair-journey__step" data-lr-journey-step>
              <div class="lr-repair-journey__copy">
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
              <img
                class="lr-repair-journey__inline-photo"
                src={step.image.replace("1280", "640")}
                srcset={`${step.image.replace("1280", "640")} 640w, ${step.image} 1280w`}
                sizes="(min-width: 768px) 40vw, 80vw"
                width="640"
                height="360"
                alt={`Иллюстрация: ${step.caption.toLocaleLowerCase("ru-RU")}`}
                loading="lazy"
                decoding="async"
              />
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
