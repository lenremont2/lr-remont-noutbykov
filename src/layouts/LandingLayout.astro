---
import "../styles/landing.scss";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title = "Lenremont Landing",
  description = "Astro landing prepared with Lenremont Landing Kit.",
  canonical,
  structuredData,
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Ленремонт" />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      structuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(structuredData).replace(/</g, "\u003c")}
        />
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main id="hop-landing">
      <slot />
    </main>

    <script>
      import "../scripts/landing.js";
    </script>
  </body>
</html>
