---
import "../styles/landing.scss";
import { typographHtml } from "../utils/typography.mjs";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
  themeable?: boolean;
  class?: string;
}

const {
  title = "Lenremont Landing",
  description = "Astro landing prepared with Lenremont Landing Kit.",
  canonical,
  structuredData,
  noindex = false,
  themeable = true,
  class: className,
} = Astro.props;
// Temporary preview control; disable before handing the fragment to WordPress.
const SHOW_THEME_PREVIEW = true;
const content = typographHtml(await Astro.slots.render("default"));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/media/lenremont-logo-patch.png" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/glightbox@3.3.1/dist/css/glightbox.min.css"
    />
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/glightbox@3.3.1/dist/js/glightbox.min.js"
    ></script>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Ленремонт" />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      structuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(structuredData).replace(/</g, "\u003c")}
        />
      )
    }
    <link
      rel="preload"
      href="/media/fonts/golos-text-v7-cyrillic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body style="margin: 0">
    <main
      id="hop-landing"
      class={className}
      data-lr-themeable={themeable || undefined}
    >
      <Fragment set:html={content} />
      {
        themeable && SHOW_THEME_PREVIEW && (
          <button
            class="lr-theme-switch"
            type="button"
            aria-label="Тёмная тема"
            role="switch"
            aria-checked="false"
            data-lr-theme-switch
            hidden
          >
            <span class="lr-theme-switch__track" aria-hidden="true" />
            <span class="lr-theme-switch__label" aria-hidden="true">
              Тёмная тема
            </span>
          </button>
        )
      }
    </main>

    <script>
      import "../scripts/landing.js";
    </script>
  </body>
</html>
