---
import "../styles/landing.scss";
import { typographHtml } from "../utils/typography.mjs";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title = "Lenremont Landing",
  description = "Astro landing prepared with Lenremont Landing Kit.",
  canonical,
  structuredData,
  noindex = false,
} = Astro.props;
const content = typographHtml(await Astro.slots.render("default"));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/media/lenremont-logo-patch.png" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Ленремонт" />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      structuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(structuredData).replace(/</g, "\u003c")}
        />
      )
    }
    <link
      rel="preload"
      href="/media/fonts/golos-text-v7-cyrillic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body style="margin: 0">
    <main id="hop-landing">
      <Fragment set:html={content} />
    </main>

    <script>
      import "../scripts/landing.js";
    </script>
  </body>
</html>
